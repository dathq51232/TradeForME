{
  "name": "quant-terminal-cloud",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "npm run dev -w @qt/web",
    "build": "npm run build -w @qt/web",
    "lint": "npm run lint -w @qt/web",
    "typecheck": "npm run typecheck -w @qt/web",
    "test": "npm test -w @qt/core -w @qt/shared && npm run test:db",
    "test:db": "node supabase/tests/pglite.mjs && node --test \"supabase/functions/_shared/*.test.ts\""
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16"
  }
}
