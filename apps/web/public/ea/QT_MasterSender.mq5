#property strict

// (already included: Api.mqh)
//==== begin Lot.mqh ====
//+------------------------------------------------------------------+
//| QT/Lot.mqh — MQL5 port of packages/shared/src/copytrade.js:       |
//| computeLot, mapSymbol, partialCloseVolume, isStale, filterReason, |
//| riskPreCheck. Must give the same results as the JS tests          |
//| (Scripts/QT_SelfTest.mq5 checks the main cases in the terminal).  |
//+------------------------------------------------------------------+
#property strict

// (already included: Json.mqh)

int QTStepDigits(double step)
  {
   int d = 0;
   while(d < 8 && MathAbs(step * MathPow(10, d) - MathRound(step * MathPow(10, d))) > 1e-9) d++;
   return d;
  }

struct QTLotArgs
  {
   string            mode;          // fixed | multiplier | balance_ratio | equity_ratio | risk_percent
   double            value;
   double            masterLot;
   double            masterBalance;
   double            masterEquity;
   double            receiverBalance;
   double            receiverEquity;
   double            masterContractSize;
   double            receiverContractSize;
   double            slDistance;
   double            tickSize;
   double            tickValue;
   double            volMin;
   double            volMax;
   double            volStep;
   double            maxLot;        // 0 = none
   double            minLot;        // 0 = none
   string            belowMin;      // skip | min_lot
  };

//--- lot > 0, or 0 with skip set to the reason
double QTComputeLot(const QTLotArgs &a, string &skip)
  {
   skip = "";
   double adj = (a.masterContractSize > 0 && a.receiverContractSize > 0) ? a.masterContractSize / a.receiverContractSize : 1.0;
   double raw = 0;
   if(a.mode == "fixed") raw = a.value;
   else if(a.mode == "multiplier") raw = a.masterLot * a.value * adj;
   else if(a.mode == "balance_ratio")
     {
      if(!(a.masterBalance > 0) || !(a.receiverBalance > 0)) { skip = "BALANCE_UNKNOWN"; return 0; }
      raw = a.masterLot * (a.receiverBalance / a.masterBalance) * a.value * adj;
     }
   else if(a.mode == "equity_ratio")
     {
      if(!(a.masterEquity > 0) || !(a.receiverEquity > 0)) { skip = "EQUITY_UNKNOWN"; return 0; }
      raw = a.masterLot * (a.receiverEquity / a.masterEquity) * a.value * adj;
     }
   else if(a.mode == "risk_percent")
     {
      if(!(a.slDistance > 0)) { skip = "NO_STOP_LOSS"; return 0; }
      if(!(a.receiverEquity > 0) || !(a.tickSize > 0) || !(a.tickValue > 0)) { skip = "SYMBOL_INFO_MISSING"; return 0; }
      double lossPerLot = (a.slDistance / a.tickSize) * a.tickValue;
      raw = (a.receiverEquity * a.value) / 100.0 / lossPerLot;
     }
   else { skip = "BAD_LOT_MODE"; return 0; }

   if(!MathIsValidNumber(raw) || raw <= 0) { skip = "BAD_LOT"; return 0; }
   double cap = a.volMax;
   if(a.maxLot > 0 && a.maxLot < cap) cap = a.maxLot;
   int d = QTStepDigits(a.volStep);
   double lot = MathFloor(raw / a.volStep + 1e-9) * a.volStep;   // round down: never trade more than asked
   lot = NormalizeDouble(MathMin(lot, cap), d);
   double floorLot = MathMax(a.volMin, a.minLot);
   if(lot < floorLot - 1e-12)
     {
      double m = NormalizeDouble(MathCeil(floorLot / a.volStep - 1e-9) * a.volStep, d);
      if(a.belowMin == "min_lot" && m <= cap + 1e-12) return m;
      skip = "BELOW_MIN_LOT";
      return 0;
     }
   return lot;
  }

//--- receiver volume for a master partial close: same fraction, rounded to step, never leaves dust
double QTPartialCloseVolume(double masterClosed, double masterBefore, double receiverVolume, double step, double vmin)
  {
   double frac = masterClosed / masterBefore;
   int d = QTStepDigits(step);
   double v = NormalizeDouble(MathRound((receiverVolume * frac) / step) * step, d);
   if(v < vmin) v = 0;
   if(receiverVolume - v < vmin) v = receiverVolume;
   return v;
  }

//--- opens older than maxAgeS are refused; exits always apply
bool QTIsStale(const string type, long tsMs, long nowMs, int maxAgeS)
  {
   if(type == "CLOSE" || type == "PARTIAL_CLOSE" || type == "KILL" || type == "MODIFY" || type == "PENDING_DELETE") return false;
   return nowMs - tsMs > (long)maxAgeS * 1000;
  }

bool QTSymbolExists(const string name)
  {
   bool custom = false;
   return SymbolExist(name, custom);
  }

//--- receiver symbol: explicit map, then exact/common suffixes, then case-insensitive; "" if none
string QTMapSymbol(const string masterSymbol, CQJ *map)
  {
   if(map != NULL && map.type == QJ_OBJ && map.Str(masterSymbol) != "") return map.Str(masterSymbol);
   string suffixes[] = {"", "m", ".m", ".r", "#", ".pro", "pro", ".a", "-ecn", ".ecn", "+", ".cash", "_i"};
   string base = masterSymbol;
   string strip[] = {".cash", ".pro", ".ecn", "-ecn", ".m", ".r", ".a", "_i", "pro", "#", "+", "m"};
   for(int i = 0; i < ArraySize(strip); i++)
     {
      int L = StringLen(strip[i]);
      if(StringLen(base) > L + 3 && StringSubstr(base, StringLen(base) - L) == strip[i]) { base = StringSubstr(base, 0, StringLen(base) - L); break; }
     }
   string roots[2];
   roots[0] = masterSymbol;
   roots[1] = base;
   for(int r = 0; r < 2; r++)
      for(int i = 0; i < ArraySize(suffixes); i++)
         if(QTSymbolExists(roots[r] + suffixes[i])) return roots[r] + suffixes[i];
   string up = masterSymbol, upBase = base;
   StringToUpper(up);
   StringToUpper(upBase);
   for(int i = 0; i < SymbolsTotal(false); i++)
     {
      string s = SymbolName(i, false), su = s;
      StringToUpper(su);
      if(su == up || su == upBase) return s;
     }
   return "";
  }

bool QTListHas(CQJ *list, const string s)
  {
   if(list == NULL || list.type != QJ_ARR || list.Size() == 0) return true; // no list = everything allowed
   for(int i = 0; i < list.Size(); i++) if(list.At(i).s == s) return true;
   return false;
  }

//--- per-receiver filters; "" = copy, otherwise the reason (mirrors filterReason)
string QTFilterReason(CQJ *e, CQJ *s, CQJ *groupSymbols)
  {
   string type = e.Str("type");
   if(type == "KILL" || type == "SNAPSHOT") return "";
   string side = e.Str("side");
   string dir = side == "" ? "" : (StringFind(side, "BUY") == 0 ? "BUY" : "SELL");
   if(type == "OPEN" || type == "PENDING_PLACE")
     {
      if(!QTListHas(groupSymbols, e.Str("symbol")) || !QTListHas(s.Get("allowed_symbols"), e.Str("symbol"))) return "SYMBOL_NOT_ALLOWED";
      string eff = (s.Bool("reverse") && dir != "") ? (dir == "BUY" ? "SELL" : "BUY") : dir;
      if(eff == "BUY" && !s.Bool("copy_buy", true)) return "BUY_DISABLED";
      if(eff == "SELL" && !s.Bool("copy_sell", true)) return "SELL_DISABLED";
     }
   if(type == "OPEN" && !s.Bool("copy_market", true)) return "MARKET_DISABLED";
   if(StringFind(type, "PENDING_") == 0 && !s.Bool("copy_pending", false)) return "PENDING_DISABLED";
   if(type == "CLOSE" && !s.Bool("copy_close", true)) return "CLOSE_DISABLED";
   if(type == "PARTIAL_CLOSE" && !s.Bool("copy_partial_close", true)) return "PARTIAL_CLOSE_DISABLED";
   if(type == "MODIFY" && (!s.Bool("copy_modify", true) || !s.Bool("copy_sl_tp", true))) return "MODIFY_DISABLED";
   return "";
  }

struct QTRiskCtx
  {
   bool              online;
   bool              tradeAllowed;
   double            lot;
   double            spreadPoints;
   int               openPositions;
   double            openLots;
   double            dayStartEquity;
   double            peakEquity;
   double            equity;
   double            marginAfter;
   double            freeMarginAfter;
  };

//--- pre-trade risk checks for a new position; "" = ok, otherwise the rule (mirrors riskPreCheck)
string QTRiskCheck(CQJ *s, const QTRiskCtx &c, string &action)
  {
   action = s.Str("risk_action", "reject");
   if(!c.online) { action = "reject"; return "RECEIVER_OFFLINE"; }
   if(!c.tradeAllowed) { action = "reject"; return "TRADE_DISABLED"; }
   if(c.freeMarginAfter < 0) return "INSUFFICIENT_MARGIN";
   if(s.Has("max_spread_points") && c.spreadPoints > s.Num("max_spread_points")) return "SPREAD_TOO_HIGH";
   if(s.Has("max_lot") && c.lot > s.Num("max_lot")) return "MAX_LOT";
   if(s.Has("max_open_positions") && c.openPositions + 1 > s.Num("max_open_positions")) return "MAX_OPEN_POSITIONS";
   if(s.Has("max_exposure_lots") && c.openLots + c.lot > s.Num("max_exposure_lots") + 1e-9) return "MAX_EXPOSURE";
   if(s.Has("max_daily_loss_pct") && c.dayStartEquity > 0 && (c.dayStartEquity - c.equity) / c.dayStartEquity * 100.0 >= s.Num("max_daily_loss_pct")) return "MAX_DAILY_LOSS";
   if(s.Has("max_drawdown_pct") && c.peakEquity > 0 && (c.peakEquity - c.equity) / c.peakEquity * 100.0 >= s.Num("max_drawdown_pct")) return "MAX_DRAWDOWN";
   if(s.Has("max_margin_usage_pct") && c.equity > 0 && c.marginAfter / c.equity * 100.0 > s.Num("max_margin_usage_pct")) return "MAX_MARGIN_USAGE";
   action = "";
   return "";
  }
//+------------------------------------------------------------------+

//==== end Lot.mqh ====

int    g_stFail = 0;
string g_stFailed = "";
bool   g_stVerbose = false;
void Check(bool ok, const string name)
  {
   if(g_stVerbose) Print(ok ? "OK   " : "FAIL ", name);
   if(!ok) { g_stFail++; g_stFailed += (g_stFailed == "" ? "" : ", ") + name; }
  }
bool Near(double a, double b) { return MathAbs(a - b) < 1e-9; }

// fills by reference: structures with strings are not returned by value
void Base(QTLotArgs &a, const string mode, double value, double masterLot)
  {
   a.mode = mode; a.value = value; a.masterLot = masterLot;
   a.masterBalance = 0; a.masterEquity = 0; a.receiverBalance = 0; a.receiverEquity = 0;
   a.masterContractSize = 0; a.receiverContractSize = 0; a.slDistance = 0; a.tickSize = 0; a.tickValue = 0;
   a.volMin = 0.01; a.volMax = 100; a.volStep = 0.01; a.maxLot = 0; a.minLot = 0; a.belowMin = "skip";
  }

//--- "ok", or "fail: <names of the failed checks>"
string QTSelfTest(const bool verbose)
  {
   g_stFail = 0; g_stFailed = ""; g_stVerbose = verbose;
   // HMAC-SHA256: RFC 4231-style vector, and the exact construction the server verifies (Node crypto)
   Check(QTHmacSha256Hex("key", "The quick brown fox jumps over the lazy dog") == "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8", "HMAC vector");
   string secret = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
   Check(QTHmacSha256Hex(secret, "1794567890000\n{\"events\":[{\"type\":\"KILL\"}]}") == "646ff1c070098e6a2ccf658c71c8b943c76fb18a089ea4e3b891a058184218d2", "HMAC matches server");

   // connection code from the dashboard
   string cu, ct, cs;
   string code = "QT1.abcdefghijklmnopqrst." + secret + "." + secret;
   Check(QTParseConnection(" " + code + " ", cu, ct, cs) && cu == "https://abcdefghijklmnopqrst.supabase.co/functions/v1" && ct == secret && cs == secret, "connection code");
   Check(!QTParseConnection("QT1.abc.def", cu, ct, cs), "bad connection code refused");

   // JSON
   CQJ j;
   Check(j.Parse("{\"a\":1.5,\"b\":\"x\\\"y\",\"c\":[1,{\"d\":true}],\"e\":null,\"seq\":1234567890123}"), "JSON parse");
   Check(Near(j.Num("a"), 1.5) && j.Str("b") == "x\"y" && j.Get("c").Size() == 2 && j.Get("c").At(1).Bool("d") && !j.Has("e"), "JSON values");
   Check(j.Long("seq") == 1234567890123, "JSON large integer");
   Check(JStr("a\"b\\") == "\"a\\\"b\\\\\"" && JNum(0.5) == "0.5" && JNum(2) == "2", "JSON writer");

   // Lot sizing (same cases as packages/shared/test/copytrade.test.js)
   string skip;
   QTLotArgs a;
   Base(a, "equity_ratio", 1, 0.5); a.masterEquity = 10000; a.receiverEquity = 3333;
   Check(Near(QTComputeLot(a, skip), 0.16), "equity_ratio rounds down");
   Base(a, "multiplier", 10, 1); a.maxLot = 3;
   Check(Near(QTComputeLot(a, skip), 3), "max_lot cap");
   Base(a, "equity_ratio", 1, 0.01); a.masterEquity = 10000; a.receiverEquity = 500;
   Check(QTComputeLot(a, skip) == 0 && skip == "BELOW_MIN_LOT", "below min skipped");
   a.belowMin = "min_lot";
   Check(Near(QTComputeLot(a, skip), 0.01), "below min -> min lot");
   Base(a, "multiplier", 1, 0.1); a.masterContractSize = 100; a.receiverContractSize = 1; a.volMin = 1; a.volMax = 1000; a.volStep = 1;
   Check(Near(QTComputeLot(a, skip), 10), "contract size conversion");
   Base(a, "risk_percent", 1, 1); a.receiverEquity = 10000; a.tickSize = 0.01; a.tickValue = 1; a.slDistance = 10;
   Check(Near(QTComputeLot(a, skip), 0.1), "risk_percent");
   a.slDistance = 0;
   Check(QTComputeLot(a, skip) == 0 && skip == "NO_STOP_LOSS", "risk_percent needs SL");
   Base(a, "balance_ratio", 1, 0.5); a.masterBalance = 10000; a.receiverBalance = 5000;
   Check(Near(QTComputeLot(a, skip), 0.25), "balance_ratio");
   Base(a, "multiplier", 0.1, 0.5); a.minLot = 0.1;
   Check(QTComputeLot(a, skip) == 0 && skip == "BELOW_MIN_LOT", "link min_lot floor");

   // partial close and staleness
   Check(Near(QTPartialCloseVolume(0.25, 0.5, 0.3, 0.01, 0.01), 0.15), "partial close fraction");
   Check(Near(QTPartialCloseVolume(0.9, 1, 0.05, 0.01, 0.01), 0.05), "partial close leaves no dust");
   Check(QTIsStale("OPEN", 1, 11001, 10) && !QTIsStale("OPEN", 1, 9001, 10) && !QTIsStale("CLOSE", 1, 999000, 10), "stale rules");

   // filters
   CQJ s, e;
   s.Parse("{\"copy_buy\":false,\"copy_sell\":true,\"reverse\":false,\"copy_pending\":false}");
   e.Parse("{\"type\":\"OPEN\",\"symbol\":\"XAUUSD\",\"side\":\"BUY\"}");
   Check(QTFilterReason(GetPointer(e), GetPointer(s), NULL) == "BUY_DISABLED", "filter: buy disabled");

   return g_stFail == 0 ? "ok" : "fail: " + g_stFailed;
  }
//+------------------------------------------------------------------+

//==== end SelfTest.mqh ====

input string InpConnection   = "";      // Mã kết nối (dán từ trang Tài khoản MT5)
input string InpBarSymbols    = "XAUUSD=XAUUSD,XAGUSD=XAGUSD,WTI=USOIL,BRENT=UKOIL"; // chart symbol=this broker's symbol; empty = do not send prices
input int    InpSnapshotSec   = 30;      // position snapshot for reconciliation (s)
input int    InpHeartbeatSec  = 30;      // heartbeat (s)
input long   InpMagicFilter   = -1;      // copy only positions with this magic (-1 = all)
input group "Nâng cao (để trống nếu đã có mã kết nối)"
input string InpApiUrl       = "";      // API URL
input string InpToken        = "";      // EA token
input string InpSecret       = "";      // HMAC secret

CQTApi   g_api;
string   g_queue[];                      // pending event JSON objects, oldest first
datetime g_lastSnapshot = 0, g_lastHeartbeat = 0, g_lastBars = 0;
long     g_login;
string   g_status = "";
int      g_sent = 0;
string   g_barMap[][2];                  // [chart symbol, broker symbol]
bool     g_barsBackfilled = false;

string QueueFile(void) { return StringFormat("QT_master_queue_%I64d.txt", g_login); }

//+------------------------------------------------------------------+
int OnInit()
  {
   g_login = AccountInfoInteger(ACCOUNT_LOGIN);
   string setupError = QTSetup(g_api, InpConnection, InpApiUrl, InpToken, InpSecret);
   if(setupError != "")
     {
      Alert("QT Master: ", setupError);
      return INIT_PARAMETERS_INCORRECT;
     }
   if(AccountInfoInteger(ACCOUNT_MARGIN_MODE) != ACCOUNT_MARGIN_MODE_RETAIL_HEDGING)
      Print("QT Master: tài khoản không phải Hedging. Thêm khối lượng vào vị thế đang có (netting) sẽ không được copy đúng.");
   ParseBarMap();
   LoadQueue();
   EventSetTimer(1);
   g_qtKind = "master";
   g_qtSelfTest = QTSelfTest(false);   // reported with the heartbeat, shown on the dashboard
   if(QTStartupCheck(g_api, "QT Master")) g_lastHeartbeat = TimeLocal();
   if(g_qtSelfTest != "ok")
     {
      Alert("QT Master: self-test lỗi (", g_qtSelfTest, "). EA dừng để không xử lý lệnh sai.");
      return INIT_FAILED;
     }
   return INIT_SUCCEEDED;
  }

void OnDeinit(const int reason)
  {
   EventKillTimer();
   SaveQueue();
   Comment("");
  }

//+------------------------------------------------------------------+
//| Trade events -> queue                                             |
//+------------------------------------------------------------------+
void OnTradeTransaction(const MqlTradeTransaction &t, const MqlTradeRequest &req, const MqlTradeResult &res)
  {
   if(t.type == TRADE_TRANSACTION_DEAL_ADD) OnDeal(t.deal);
   else if(t.type == TRADE_TRANSACTION_POSITION) OnPositionChange(t);
   else if(t.type == TRADE_TRANSACTION_ORDER_ADD || t.type == TRADE_TRANSACTION_ORDER_UPDATE || t.type == TRADE_TRANSACTION_ORDER_DELETE)
      OnPendingOrder(t);
   Flush();
  }

bool MagicOk(long magic) { return InpMagicFilter < 0 || magic == InpMagicFilter; }

string Common(const string uid, const string type)
  {
   return JKs("event_uid", uid) + "," + JKs("type", type) + "," + JKi("ts_ms", QTNowMs());
  }

void OnDeal(ulong deal)
  {
   if(!HistoryDealSelect(deal)) return;
   long entry = HistoryDealGetInteger(deal, DEAL_ENTRY);
   long dtype = HistoryDealGetInteger(deal, DEAL_TYPE);
   if(dtype != DEAL_TYPE_BUY && dtype != DEAL_TYPE_SELL) return;   // balance, commission, ...
   if(!MagicOk(HistoryDealGetInteger(deal, DEAL_MAGIC)) && entry == DEAL_ENTRY_IN) return;
   long pos = HistoryDealGetInteger(deal, DEAL_POSITION_ID);
   string sym = HistoryDealGetString(deal, DEAL_SYMBOL);
   double vol = HistoryDealGetDouble(deal, DEAL_VOLUME);
   double price = HistoryDealGetDouble(deal, DEAL_PRICE);
   string uidBase = StringFormat("%I64d-DEAL-%I64u", g_login, deal);

   if(entry == DEAL_ENTRY_IN)
     {
      string e = "{" + Common(uidBase, "OPEN") + "," + JKi("master_ticket", pos) + "," + JKs("symbol", sym) + ","
                 + JKs("side", dtype == DEAL_TYPE_BUY ? "BUY" : "SELL") + "," + JKn("volume", vol) + "," + JKn("price", price) + ","
                 + JKn("master_balance", AccountInfoDouble(ACCOUNT_BALANCE)) + "," + JKn("master_equity", AccountInfoDouble(ACCOUNT_EQUITY)) + ","
                 + JKn("contract_size", SymbolInfoDouble(sym, SYMBOL_TRADE_CONTRACT_SIZE));
      if(PositionSelectByTicket(pos))
        {
         if(PositionGetDouble(POSITION_SL) > 0) e += "," + JKn("sl", PositionGetDouble(POSITION_SL));
         if(PositionGetDouble(POSITION_TP) > 0) e += "," + JKn("tp", PositionGetDouble(POSITION_TP));
        }
      Enqueue(e + "}");
     }
   else if(entry == DEAL_ENTRY_OUT || entry == DEAL_ENTRY_OUT_BY)
     {
      if(PositionSelectByTicket(pos))
        {
         double remaining = PositionGetDouble(POSITION_VOLUME);
         Enqueue("{" + Common(uidBase, "PARTIAL_CLOSE") + "," + JKi("master_ticket", pos) + "," + JKs("symbol", sym) + ","
                 + JKn("volume", vol) + "," + JKn("volume_before", remaining + vol) + "," + JKn("price", price) + "}");
        }
      else
         Enqueue("{" + Common(uidBase, "CLOSE") + "," + JKi("master_ticket", pos) + "," + JKs("symbol", sym) + "," + JKn("price", price) + "}");
     }
   else if(entry == DEAL_ENTRY_INOUT)
      Print("QT Master: lệnh đảo chiều (netting) chưa được hỗ trợ, deal ", deal);
  }

//--- SL/TP changes of an open position
void OnPositionChange(const MqlTradeTransaction &t)
  {
   if(!PositionSelectByTicket(t.position)) return;
   if(!MagicOk(PositionGetInteger(POSITION_MAGIC))) return;
   string uid = StringFormat("%I64d-MOD-%I64u-%I64u", g_login, t.position, GetMicrosecondCount());
   string e = "{" + Common(uid, "MODIFY") + "," + JKi("master_ticket", (long)t.position) + "," + JKs("symbol", t.symbol);
   if(t.price_sl > 0) e += "," + JKn("sl", t.price_sl);
   if(t.price_tp > 0) e += "," + JKn("tp", t.price_tp);
   Enqueue(e + "}");
  }

string PendingSide(ENUM_ORDER_TYPE t)
  {
   switch(t)
     {
      case ORDER_TYPE_BUY_LIMIT: return "BUY_LIMIT";
      case ORDER_TYPE_SELL_LIMIT: return "SELL_LIMIT";
      case ORDER_TYPE_BUY_STOP: return "BUY_STOP";
      case ORDER_TYPE_SELL_STOP: return "SELL_STOP";
     }
   return "";
  }

void OnPendingOrder(const MqlTradeTransaction &t)
  {
   string side = PendingSide(t.order_type);
   if(side == "") return;                                  // market orders arrive as deals
   string id = StringFormat("%I64d-ORD-%I64u", g_login, t.order);
   if(t.type == TRADE_TRANSACTION_ORDER_ADD)
     {
      string e = "{" + Common(id + "-ADD", "PENDING_PLACE") + "," + JKi("master_ticket", (long)t.order) + "," + JKs("symbol", t.symbol) + ","
                 + JKs("side", side) + "," + JKn("volume", t.volume) + "," + JKn("price", t.price) + ","
                 + JKn("master_balance", AccountInfoDouble(ACCOUNT_BALANCE)) + "," + JKn("master_equity", AccountInfoDouble(ACCOUNT_EQUITY)) + ","
                 + JKn("contract_size", SymbolInfoDouble(t.symbol, SYMBOL_TRADE_CONTRACT_SIZE));
      if(t.price_sl > 0) e += "," + JKn("sl", t.price_sl);
      if(t.price_tp > 0) e += "," + JKn("tp", t.price_tp);
      Enqueue(e + "}");
     }
   else if(t.type == TRADE_TRANSACTION_ORDER_UPDATE)
     {
      string e = "{" + Common(StringFormat("%s-UPD-%I64u", id, GetMicrosecondCount()), "PENDING_MODIFY") + "," + JKi("master_ticket", (long)t.order) + ","
                 + JKn("price", t.price);
      if(t.price_sl > 0) e += "," + JKn("sl", t.price_sl);
      if(t.price_tp > 0) e += "," + JKn("tp", t.price_tp);
      Enqueue(e + "}");
     }
   else if(t.order_state == ORDER_STATE_CANCELED || t.order_state == ORDER_STATE_EXPIRED || t.order_state == ORDER_STATE_REJECTED)
      // a FILLED pending order becomes a position: its deal sends OPEN with master_ticket = this order ticket
      Enqueue("{" + Common(id + "-DEL", "PENDING_DELETE") + "," + JKi("master_ticket", (long)t.order) + "}");
  }

//+------------------------------------------------------------------+
//| Timer: retry queue, snapshot, heartbeat, broker bars              |
//+------------------------------------------------------------------+
void OnTimer()
  {
   datetime now = TimeLocal();
   Flush();
   if(now - g_lastSnapshot >= InpSnapshotSec) { Snapshot(); g_lastSnapshot = now; Flush(); }
   if(now - g_lastHeartbeat >= InpHeartbeatSec) { Heartbeat(); g_lastHeartbeat = now; }
   if(ArrayRange(g_barMap, 0) > 0 && now - g_lastBars >= 60) { PushBars(); g_lastBars = now; }
   Comment(StringFormat("QT Master %s\nĐã gửi: %d sự kiện · hàng đợi: %d\n%s", QT_EA_VERSION, g_sent, ArraySize(g_queue), g_status));
  }

void Snapshot()
  {
   string list = "";
   for(int i = 0; i < PositionsTotal(); i++)
     {
      ulong tk = PositionGetTicket(i);
      if(tk == 0 || !MagicOk(PositionGetInteger(POSITION_MAGIC))) continue;
      string p = "{" + JKi("master_ticket", (long)tk) + "," + JKs("symbol", PositionGetString(POSITION_SYMBOL)) + ","
                 + JKs("side", PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY ? "BUY" : "SELL") + ","
                 + JKn("volume", PositionGetDouble(POSITION_VOLUME)) + "," + JKn("price", PositionGetDouble(POSITION_PRICE_OPEN));
      if(PositionGetDouble(POSITION_SL) > 0) p += "," + JKn("sl", PositionGetDouble(POSITION_SL));
      if(PositionGetDouble(POSITION_TP) > 0) p += "," + JKn("tp", PositionGetDouble(POSITION_TP));
      list += (list == "" ? "" : ",") + p + "}";
     }
   Enqueue("{" + Common(StringFormat("%I64d-SNAP-%I64d", g_login, QTNowMs()), "SNAPSHOT") + ",\"positions\":[" + list + "]}");
  }

void Heartbeat()
  {
   string resp;
   int code = g_api.Post("/ct-heartbeat", QTHeartbeatBody(g_status == "" ? "" : g_status), 8000, resp);
   if(code == 426) Alert("QT Master: cần cập nhật EA. ", g_api.lastError);
   if(code != 200) g_status = "Heartbeat lỗi: " + g_api.lastError;
   else if(StringFind(g_status, "Heartbeat") == 0) g_status = "";
  }

//+------------------------------------------------------------------+
//| Queue                                                             |
//+------------------------------------------------------------------+
void Enqueue(const string e)
  {
   int n = ArraySize(g_queue);
   if(n >= 5000) { Print("QT Master: hàng đợi đầy, bỏ sự kiện cũ nhất"); ArrayRemove(g_queue, 0, 1); n--; }
   ArrayResize(g_queue, n + 1);
   g_queue[n] = e;
  }

void Flush()
  {
   while(ArraySize(g_queue) > 0)
     {
      int k = MathMin(50, ArraySize(g_queue));
      string body = "{\"events\":[";
      for(int i = 0; i < k; i++) body += (i ? "," : "") + g_queue[i];
      body += "]}";
      string resp;
      int code = g_api.Post("/ct-ingest", body, 8000, resp);
      if(code == 200)
        {
         ArrayRemove(g_queue, 0, k);
         g_sent += k;
         g_status = "";
         continue;
        }
      if(code == 400)
        {
         // a malformed event would block the queue forever: log and drop this batch
         Print("QT Master: máy chủ từ chối sự kiện (400), bỏ qua: ", resp);
         ArrayRemove(g_queue, 0, k);
         continue;
        }
      g_status = "Gửi lỗi, sẽ thử lại: " + g_api.lastError;
      SaveQueue();
      return;
     }
   SaveQueue();
  }

void SaveQueue()
  {
   int h = FileOpen(QueueFile(), FILE_WRITE | FILE_TXT | FILE_ANSI);
   if(h == INVALID_HANDLE) return;
   for(int i = 0; i < ArraySize(g_queue); i++) FileWriteString(h, g_queue[i] + "\n");
   FileClose(h);
  }

void LoadQueue()
  {
   if(!FileIsExist(QueueFile())) return;
   int h = FileOpen(QueueFile(), FILE_READ | FILE_TXT | FILE_ANSI);
   if(h == INVALID_HANDLE) return;
   while(!FileIsEnding(h))
     {
      string line = FileReadString(h);
      if(StringLen(line) > 2) Enqueue(line);
     }
   FileClose(h);
   if(ArraySize(g_queue) > 0) Print("QT Master: gửi lại ", ArraySize(g_queue), " sự kiện chưa gửi từ lần chạy trước");
  }

//+------------------------------------------------------------------+
//| Broker M1 bars for the cloud chart                                |
//+------------------------------------------------------------------+
void ParseBarMap()
  {
   ArrayResize(g_barMap, 0);
   string parts[];
   int n = StringSplit(InpBarSymbols, ',', parts);
   for(int i = 0; i < n; i++)
     {
      string kv[];
      if(StringSplit(parts[i], '=', kv) != 2) continue;
      StringTrimLeft(kv[0]); StringTrimRight(kv[0]); StringTrimLeft(kv[1]); StringTrimRight(kv[1]);
      if(!QTSymbolExistsSimple(kv[1])) { Print("QT Master: không có symbol ", kv[1], " trên broker này, bỏ qua giá ", kv[0]); continue; }
      SymbolSelect(kv[1], true);
      int k = ArrayRange(g_barMap, 0);
      ArrayResize(g_barMap, k + 1);
      g_barMap[k][0] = kv[0];
      g_barMap[k][1] = kv[1];
     }
  }

bool QTSymbolExistsSimple(const string s) { bool custom = false; return SymbolExist(s, custom); }

void PushBars()
  {
   // broker server time -> UTC, rounded to 15 minutes
   int offset = (int)MathRound((double)(TimeTradeServer() - TimeGMT()) / 900.0) * 900;
   int count = g_barsBackfilled ? 3 : 120;   // server accepts 500 bars per call: 4 symbols x 120
   string list = "";
   for(int i = 0; i < ArrayRange(g_barMap, 0); i++)
     {
      MqlRates r[];
      int got = CopyRates(g_barMap[i][1], PERIOD_M1, 1, count, r);   // closed bars only
      for(int j = 0; j < got; j++)
         list += (list == "" ? "" : ",") + "{" + JKs("symbol", g_barMap[i][0]) + "," + JKi("t", (long)r[j].time - offset) + ","
                 + JKn("o", r[j].open) + "," + JKn("h", r[j].high) + "," + JKn("l", r[j].low) + "," + JKn("c", r[j].close) + ","
                 + JKn("v", (double)r[j].tick_volume) + "}";
     }
   if(list == "") return;
   string resp;
   if(g_api.Post("/ct-bars", "{\"bars\":[" + list + "]}", 8000, resp) == 200) g_barsBackfilled = true;
  }
//+------------------------------------------------------------------+
