// GENERATED by mql5/build.mjs from mql5/Experts/QT_MasterSender.mq5 and mql5/Include/QT. Edit those, then run: node mql5/build.mjs
//+------------------------------------------------------------------+
//| QT_MasterSender.mq5 — sends this account's trades to Quant        |
//| Terminal Cloud, which fans them out to the linked receivers.      |
//|                                                                  |
//| Setup: attach to ONE chart of the master terminal. Allow          |
//| WebRequest for the API URL (Tools > Options > Expert Advisors).   |
//| Token and secret come from the dashboard (Tài khoản MT5).         |
//+------------------------------------------------------------------+
#property copyright "Quant Terminal Cloud (MIT)"
#property version   "1.00"
#property strict

//==== begin Api.mqh ====
//+------------------------------------------------------------------+
//| QT/Api.mqh — signed HTTPS calls to the Quant Terminal Edge        |
//| Functions. Signature = hex HMAC-SHA256(secret, ts + "\n" + body), |
//| matching supabase/functions/_shared/ea.ts.                        |
//+------------------------------------------------------------------+
#property strict

//==== begin Json.mqh ====
//+------------------------------------------------------------------+
//| QT/Json.mqh — small JSON reader and writer helpers for the EAs.   |
//| Reader: CQJ tree (null, bool, number, string, array, object).     |
//| Writer: JStr/JNum/JInt build JSON text by concatenation.          |
//+------------------------------------------------------------------+
#property strict

enum ENUM_QJ { QJ_NULL, QJ_BOOL, QJ_NUM, QJ_STR, QJ_ARR, QJ_OBJ };

class CQJ
  {
public:
   ENUM_QJ           type;
   bool              b;
   double            n;
   string            s;
   string            key;
   CQJ              *items[];

                     CQJ(void) { type = QJ_NULL; b = false; n = 0; }
                    ~CQJ(void) { Clear(); }
   void              Clear(void)
     {
      for(int i = 0; i < ArraySize(items); i++)
         if(CheckPointer(items[i]) == POINTER_DYNAMIC) delete items[i];
      ArrayResize(items, 0);
     }
   int               Size(void) { return ArraySize(items); }
   CQJ              *At(int i) { return (i >= 0 && i < ArraySize(items)) ? items[i] : NULL; }
   CQJ              *Get(const string k)
     {
      for(int i = 0; i < ArraySize(items); i++)
         if(items[i].key == k) return items[i];
      return NULL;
     }
   bool              Has(const string k) { CQJ *v = Get(k); return v != NULL && v.type != QJ_NULL; }
   double            Num(const string k, double def = 0.0)
     {
      CQJ *v = Get(k);
      if(v == NULL) return def;
      if(v.type == QJ_NUM) return v.n;
      if(v.type == QJ_STR) return StringToDouble(v.s);
      return def;
     }
   long              Long(const string k, long def = 0) { return Has(k) ? (long)MathRound(Num(k)) : def; }
   string            Str(const string k, const string def = "")
     {
      CQJ *v = Get(k);
      if(v == NULL || v.type == QJ_NULL) return def;
      if(v.type == QJ_STR) return v.s;
      if(v.type == QJ_NUM) return JNumText(v.n);
      if(v.type == QJ_BOOL) return v.b ? "true" : "false";
      return def;
     }
   bool              Bool(const string k, bool def = false)
     {
      CQJ *v = Get(k);
      if(v == NULL || v.type != QJ_BOOL) return def;
      return v.b;
     }

   //--- parse a whole document; false on syntax error
   bool              Parse(const string text)
     {
      Clear(); type = QJ_NULL;
      int p = 0;
      if(!ParseValue(text, p)) return false;
      SkipWs(text, p);
      return p == StringLen(text);
     }

   static string     JNumText(double v)
     {
      if(v == MathRound(v) && MathAbs(v) < 1e15) return StringFormat("%.0f", v);
      string s = DoubleToString(v, 8);
      int len = StringLen(s);
      while(len > 0 && StringGetCharacter(s, len - 1) == '0') len--;
      if(len > 0 && StringGetCharacter(s, len - 1) == '.') len--;
      return StringSubstr(s, 0, len);
     }

private:
   void              SkipWs(const string &t, int &p)
     {
      int len = StringLen(t);
      while(p < len)
        {
         ushort c = StringGetCharacter(t, p);
         if(c == ' ' || c == '\t' || c == '\n' || c == '\r') p++;
         else break;
        }
     }
   bool              ParseValue(const string &t, int &p)
     {
      SkipWs(t, p);
      if(p >= StringLen(t)) return false;
      ushort c = StringGetCharacter(t, p);
      if(c == '{') return ParseObject(t, p);
      if(c == '[') return ParseArray(t, p);
      if(c == '"') { type = QJ_STR; return ParseString(t, p, s); }
      if(StringSubstr(t, p, 4) == "true") { type = QJ_BOOL; b = true; p += 4; return true; }
      if(StringSubstr(t, p, 5) == "false") { type = QJ_BOOL; b = false; p += 5; return true; }
      if(StringSubstr(t, p, 4) == "null") { type = QJ_NULL; p += 4; return true; }
      return ParseNumber(t, p);
     }
   bool              ParseNumber(const string &t, int &p)
     {
      int start = p, len = StringLen(t);
      while(p < len)
        {
         ushort c = StringGetCharacter(t, p);
         if((c >= '0' && c <= '9') || c == '-' || c == '+' || c == '.' || c == 'e' || c == 'E') p++;
         else break;
        }
      if(p == start) return false;
      type = QJ_NUM;
      n = StringToDouble(StringSubstr(t, start, p - start));
      return true;
     }
   bool              ParseString(const string &t, int &p, string &out)
     {
      out = "";
      p++; // opening quote
      int len = StringLen(t);
      while(p < len)
        {
         ushort c = StringGetCharacter(t, p);
         if(c == '"') { p++; return true; }
         if(c == '\\')
           {
            p++;
            if(p >= len) return false;
            ushort e = StringGetCharacter(t, p);
            if(e == 'n') out += "\n";
            else if(e == 'r') out += "\r";
            else if(e == 't') out += "\t";
            else if(e == 'b') out += ShortToString(8);
            else if(e == 'f') out += ShortToString(12);
            else if(e == 'u')
              {
               if(p + 4 >= len) return false;
               out += ShortToString((ushort)HexToInt(StringSubstr(t, p + 1, 4)));
               p += 4;
              }
            else out += ShortToString(e); // \" \\ \/
            p++;
            continue;
           }
         out += ShortToString(c);
         p++;
        }
      return false;
     }
   bool              ParseArray(const string &t, int &p)
     {
      type = QJ_ARR;
      p++;
      SkipWs(t, p);
      if(p < StringLen(t) && StringGetCharacter(t, p) == ']') { p++; return true; }
      while(p < StringLen(t))
        {
         CQJ *v = new CQJ();
         int k = ArraySize(items);
         ArrayResize(items, k + 1);
         items[k] = v;
         if(!v.ParseValue(t, p)) return false;
         SkipWs(t, p);
         if(p >= StringLen(t)) return false;
         ushort c = StringGetCharacter(t, p);
         p++;
         if(c == ']') return true;
         if(c != ',') return false;
        }
      return false;
     }
   bool              ParseObject(const string &t, int &p)
     {
      type = QJ_OBJ;
      p++;
      SkipWs(t, p);
      if(p < StringLen(t) && StringGetCharacter(t, p) == '}') { p++; return true; }
      while(p < StringLen(t))
        {
         SkipWs(t, p);
         if(p >= StringLen(t) || StringGetCharacter(t, p) != '"') return false;
         string k;
         if(!ParseString(t, p, k)) return false;
         SkipWs(t, p);
         if(p >= StringLen(t) || StringGetCharacter(t, p) != ':') return false;
         p++;
         CQJ *v = new CQJ();
         v.key = k;
         int i = ArraySize(items);
         ArrayResize(items, i + 1);
         items[i] = v;
         if(!v.ParseValue(t, p)) return false;
         SkipWs(t, p);
         if(p >= StringLen(t)) return false;
         ushort c = StringGetCharacter(t, p);
         p++;
         if(c == '}') return true;
         if(c != ',') return false;
        }
      return false;
     }
   static int        HexToInt(const string h)
     {
      int v = 0;
      for(int i = 0; i < StringLen(h); i++)
        {
         ushort c = StringGetCharacter(h, i);
         int d = (c >= '0' && c <= '9') ? c - '0' : (c >= 'a' && c <= 'f') ? c - 'a' + 10 : (c >= 'A' && c <= 'F') ? c - 'A' + 10 : 0;
         v = v * 16 + d;
        }
      return v;
     }
  };

//--- writer helpers ------------------------------------------------
string JStr(const string s)
  {
   string out = "\"";
   for(int i = 0; i < StringLen(s); i++)
     {
      ushort c = StringGetCharacter(s, i);
      if(c == '"') out += "\\\"";
      else if(c == '\\') out += "\\\\";
      else if(c == '\n') out += "\\n";
      else if(c == '\r') out += "\\r";
      else if(c == '\t') out += "\\t";
      else if(c < 32 || c > 126) out += StringFormat("\\u%04x", c); // keep the body ASCII: it is signed byte for byte
      else out += ShortToString(c);
     }
   return out + "\"";
  }
string JNum(double v) { return CQJ::JNumText(v); }
string JInt(long v) { return StringFormat("%I64d", v); }
string JBool(bool v) { return v ? "true" : "false"; }
//--- "key":value fragments
string JKs(const string k, const string v) { return JStr(k) + ":" + JStr(v); }
string JKn(const string k, double v) { return JStr(k) + ":" + JNum(v); }
string JKi(const string k, long v) { return JStr(k) + ":" + JInt(v); }
string JKb(const string k, bool v) { return JStr(k) + ":" + JBool(v); }
//+------------------------------------------------------------------+

//==== end Json.mqh ====

#define QT_EA_VERSION "1.0.0"

//--- SHA-256 of a byte array
void QTSha256(const uchar &data[], uchar &out[])
  {
   uchar nokey[];
   ArrayResize(nokey, 0);
   CryptEncode(CRYPT_HASH_SHA256, data, nokey, out);
  }

//--- UTF-8 bytes of a string, without the terminating zero
void QTBytes(const string s, uchar &out[])
  {
   int n = StringToCharArray(s, out, 0, WHOLE_ARRAY, CP_UTF8);
   if(n > 0 && out[n - 1] == 0) ArrayResize(out, n - 1);
  }

string QTHex(const uchar &b[])
  {
   string h = "";
   for(int i = 0; i < ArraySize(b); i++) h += StringFormat("%02x", b[i]);
   return h;
  }

//--- RFC 2104 HMAC with SHA-256
string QTHmacSha256Hex(const string secret, const string message)
  {
   uchar key[], msg[];
   QTBytes(secret, key);
   QTBytes(message, msg);
   if(ArraySize(key) > 64)
     {
      uchar hk[];
      QTSha256(key, hk);
      ArrayFree(key);
      ArrayCopy(key, hk);
     }
   uchar k0[];
   ArrayResize(k0, 64);
   ArrayInitialize(k0, 0);
   ArrayCopy(k0, key, 0, 0, ArraySize(key));

   uchar inner[];
   ArrayResize(inner, 64 + ArraySize(msg));
   for(int i = 0; i < 64; i++) inner[i] = (uchar)(k0[i] ^ 0x36);
   ArrayCopy(inner, msg, 64, 0, ArraySize(msg));
   uchar ih[];
   QTSha256(inner, ih);

   uchar outer[];
   ArrayResize(outer, 64 + ArraySize(ih));
   for(int i = 0; i < 64; i++) outer[i] = (uchar)(k0[i] ^ 0x5c);
   ArrayCopy(outer, ih, 64, 0, ArraySize(ih));
   uchar oh[];
   QTSha256(outer, oh);
   return QTHex(oh);
  }

//--- milliseconds since 1970 UTC (second precision is enough for the 60 s window)
long QTNowMs(void) { return (long)TimeGMT() * 1000; }

class CQTApi
  {
private:
   string            m_base;
   string            m_token;
   string            m_secret;
public:
   string            lastError;
   int               lastStatus;

   void              Init(const string base, const string token, const string secret)
     {
      m_base = base;
      while(StringLen(m_base) > 0 && StringGetCharacter(m_base, StringLen(m_base) - 1) == '/')
         m_base = StringSubstr(m_base, 0, StringLen(m_base) - 1);
      m_token = token;
      m_secret = secret;
     }
   bool              Configured(void) { return StringLen(m_token) == 64 && StringLen(m_secret) == 64 && StringFind(m_base, "https://") == 0; }

   //--- POST a JSON body; returns HTTP status or -1 (network / WebRequest not allowed)
   int               Post(const string path, const string body, const int timeoutMs, string &response)
     {
      string ts = StringFormat("%I64d", QTNowMs());
      string headers = "Content-Type: application/json\r\n"
                       "X-QT-Token: " + m_token + "\r\n"
                       "X-QT-Timestamp: " + ts + "\r\n"
                       "X-QT-Signature: " + QTHmacSha256Hex(m_secret, ts + "\n" + body) + "\r\n"
                       "X-QT-Version: " + QT_EA_VERSION + "\r\n";
      char data[], result[];
      int n = StringToCharArray(body, data, 0, WHOLE_ARRAY, CP_UTF8);
      if(n > 0 && data[n - 1] == 0) ArrayResize(data, n - 1);
      string rh;
      ResetLastError();
      int code = WebRequest("POST", m_base + path, headers, timeoutMs, data, result, rh);
      lastStatus = code;
      if(code == -1)
        {
         int err = GetLastError();
         lastError = err == 4014
                     ? "Chưa cho phép WebRequest: Tools > Options > Expert Advisors > Allow WebRequest, thêm " + m_base
                     : "Lỗi mạng (WebRequest " + IntegerToString(err) + ")";
         response = "";
         return -1;
        }
      response = CharArrayToString(result, 0, WHOLE_ARRAY, CP_UTF8);
      if(code >= 400)
        {
         CQJ j;
         lastError = (j.Parse(response) ? j.Str("error") + " " + j.Str("message") : "HTTP " + IntegerToString(code));
        }
      else lastError = "";
      return code;
     }
  };

//--- "QT1.<project-ref>.<token>.<secret>" (the dashboard's connection code) -> url, token, secret
bool QTParseConnection(string code, string &url, string &token, string &secret)
  {
   StringTrimLeft(code);
   StringTrimRight(code);
   string p[];
   if(StringSplit(code, '.', p) != 4 || p[0] != "QT1") return false;
   if(StringLen(p[1]) < 10 || StringLen(p[2]) != 64 || StringLen(p[3]) != 64) return false;
   url = "https://" + p[1] + ".supabase.co/functions/v1";
   token = p[2];
   secret = p[3];
   return true;
  }

//--- configure from the connection code, or from the advanced inputs when no code is given; "" = ok
string QTSetup(CQTApi &api, const string code, const string url, const string token, const string secret)
  {
   string u = url, t = token, s = secret;
   if(StringLen(code) > 0 && !QTParseConnection(code, u, t, s))
      return "Mã kết nối không đúng. Chép lại nguyên dòng bắt đầu bằng QT1. từ trang Tài khoản MT5.";
   api.Init(u, t, s);
   if(!api.Configured()) return "Chưa có mã kết nối. Dán mã từ trang Tài khoản MT5 vào ô \"Mã kết nối\".";
   return "";
  }

//--- first call at start-up: explains the usual setup mistakes in plain words
bool QTStartupCheck(CQTApi &api, const string who)
  {
   string resp;
   int code = api.Post("/ct-heartbeat", QTHeartbeatBody(""), 8000, resp);
   if(code == 200) { Print(who, ": đã kết nối máy chủ"); return true; }
   if(code == -1) Alert(who, ": ", api.lastError);
   else if(code == 401) Alert(who, ": máy chủ từ chối (", api.lastError, "). Mã kết nối sai hoặc đã được cấp lại; nếu báo CLOCK_SKEW thì chỉnh lại đồng hồ máy.");
   else if(code == 403) Alert(who, ": ", api.lastError);
   else if(code == 426) Alert(who, ": cần tải bản EA mới. ", api.lastError);
   else Alert(who, ": lỗi máy chủ ", code, " ", api.lastError);
   return false;
  }

//--- live account state for /ct-heartbeat (both EAs)
string QTHeartbeatBody(const string lastError)
  {
   bool tradeAllowed = TerminalInfoInteger(TERMINAL_TRADE_ALLOWED) && MQLInfoInteger(MQL_TRADE_ALLOWED)
                       && AccountInfoInteger(ACCOUNT_TRADE_ALLOWED) && AccountInfoInteger(ACCOUNT_TRADE_EXPERT);
   bool hedging = AccountInfoInteger(ACCOUNT_MARGIN_MODE) == ACCOUNT_MARGIN_MODE_RETAIL_HEDGING;
   return "{" + JKn("balance", AccountInfoDouble(ACCOUNT_BALANCE)) + ","
          + JKn("equity", AccountInfoDouble(ACCOUNT_EQUITY)) + ","
          + JKn("margin", AccountInfoDouble(ACCOUNT_MARGIN)) + ","
          + JKn("margin_level", AccountInfoDouble(ACCOUNT_MARGIN_LEVEL)) + ","
          + JKn("floating_pl", AccountInfoDouble(ACCOUNT_PROFIT)) + ","
          + JKi("open_positions", PositionsTotal()) + ","
          + JKs("currency", AccountInfoString(ACCOUNT_CURRENCY)) + ","
          + JKs("account_type", hedging ? "hedging" : "netting") + ","
          + JKb("terminal_connected", (bool)TerminalInfoInteger(TERMINAL_CONNECTED)) + ","
          + JKb("trade_allowed", tradeAllowed) + ","
          + JKs("ea_version", QT_EA_VERSION) + ","
          + JKs("last_error", lastError) + "}";
  }
//+------------------------------------------------------------------+

//==== end Api.mqh ====

input string InpConnection   = "";      // Mã kết nối (dán từ trang Tài khoản MT5)
input string InpBarSymbols    = "XAUUSD=XAUUSD,XAGUSD=XAGUSD,WTI=USOIL,BRENT=UKOIL"; // chart symbol=this broker's symbol; empty = do not send prices
input int    InpSnapshotSec   = 30;      // position snapshot for reconciliation (s)
input int    InpHeartbeatSec  = 30;      // heartbeat (s)
input long   InpMagicFilter   = -1;      // copy only positions with this magic (-1 = all)
input group "Nâng cao (để trống nếu đã có mã kết nối)"
input string InpApiUrl       = "";      // API URL
input string InpToken        = "";      // EA token
input string InpSecret       = "";      // HMAC secret

CQTApi   g_api;
string   g_queue[];                      // pending event JSON objects, oldest first
datetime g_lastSnapshot = 0, g_lastHeartbeat = 0, g_lastBars = 0;
long     g_login;
string   g_status = "";
int      g_sent = 0;
string   g_barMap[][2];                  // [chart symbol, broker symbol]
bool     g_barsBackfilled = false;

string QueueFile(void) { return StringFormat("QT_master_queue_%I64d.txt", g_login); }

//+------------------------------------------------------------------+
int OnInit()
  {
   g_login = AccountInfoInteger(ACCOUNT_LOGIN);
   string setupError = QTSetup(g_api, InpConnection, InpApiUrl, InpToken, InpSecret);
   if(setupError != "")
     {
      Alert("QT Master: ", setupError);
      return INIT_PARAMETERS_INCORRECT;
     }
   if(AccountInfoInteger(ACCOUNT_MARGIN_MODE) != ACCOUNT_MARGIN_MODE_RETAIL_HEDGING)
      Print("QT Master: tài khoản không phải Hedging. Thêm khối lượng vào vị thế đang có (netting) sẽ không được copy đúng.");
   ParseBarMap();
   LoadQueue();
   EventSetTimer(1);
   if(QTStartupCheck(g_api, "QT Master")) g_lastHeartbeat = TimeLocal();
   return INIT_SUCCEEDED;
  }

void OnDeinit(const int reason)
  {
   EventKillTimer();
   SaveQueue();
   Comment("");
  }

//+------------------------------------------------------------------+
//| Trade events -> queue                                             |
//+------------------------------------------------------------------+
void OnTradeTransaction(const MqlTradeTransaction &t, const MqlTradeRequest &req, const MqlTradeResult &res)
  {
   if(t.type == TRADE_TRANSACTION_DEAL_ADD) OnDeal(t.deal);
   else if(t.type == TRADE_TRANSACTION_POSITION) OnPositionChange(t);
   else if(t.type == TRADE_TRANSACTION_ORDER_ADD || t.type == TRADE_TRANSACTION_ORDER_UPDATE || t.type == TRADE_TRANSACTION_ORDER_DELETE)
      OnPendingOrder(t);
   Flush();
  }

bool MagicOk(long magic) { return InpMagicFilter < 0 || magic == InpMagicFilter; }

string Common(const string uid, const string type)
  {
   return JKs("event_uid", uid) + "," + JKs("type", type) + "," + JKi("ts_ms", QTNowMs());
  }

void OnDeal(ulong deal)
  {
   if(!HistoryDealSelect(deal)) return;
   long entry = HistoryDealGetInteger(deal, DEAL_ENTRY);
   long dtype = HistoryDealGetInteger(deal, DEAL_TYPE);
   if(dtype != DEAL_TYPE_BUY && dtype != DEAL_TYPE_SELL) return;   // balance, commission, ...
   if(!MagicOk(HistoryDealGetInteger(deal, DEAL_MAGIC)) && entry == DEAL_ENTRY_IN) return;
   long pos = HistoryDealGetInteger(deal, DEAL_POSITION_ID);
   string sym = HistoryDealGetString(deal, DEAL_SYMBOL);
   double vol = HistoryDealGetDouble(deal, DEAL_VOLUME);
   double price = HistoryDealGetDouble(deal, DEAL_PRICE);
   string uidBase = StringFormat("%I64d-DEAL-%I64u", g_login, deal);

   if(entry == DEAL_ENTRY_IN)
     {
      string e = "{" + Common(uidBase, "OPEN") + "," + JKi("master_ticket", pos) + "," + JKs("symbol", sym) + ","
                 + JKs("side", dtype == DEAL_TYPE_BUY ? "BUY" : "SELL") + "," + JKn("volume", vol) + "," + JKn("price", price) + ","
                 + JKn("master_balance", AccountInfoDouble(ACCOUNT_BALANCE)) + "," + JKn("master_equity", AccountInfoDouble(ACCOUNT_EQUITY)) + ","
                 + JKn("contract_size", SymbolInfoDouble(sym, SYMBOL_TRADE_CONTRACT_SIZE));
      if(PositionSelectByTicket(pos))
        {
         if(PositionGetDouble(POSITION_SL) > 0) e += "," + JKn("sl", PositionGetDouble(POSITION_SL));
         if(PositionGetDouble(POSITION_TP) > 0) e += "," + JKn("tp", PositionGetDouble(POSITION_TP));
        }
      Enqueue(e + "}");
     }
   else if(entry == DEAL_ENTRY_OUT || entry == DEAL_ENTRY_OUT_BY)
     {
      if(PositionSelectByTicket(pos))
        {
         double remaining = PositionGetDouble(POSITION_VOLUME);
         Enqueue("{" + Common(uidBase, "PARTIAL_CLOSE") + "," + JKi("master_ticket", pos) + "," + JKs("symbol", sym) + ","
                 + JKn("volume", vol) + "," + JKn("volume_before", remaining + vol) + "," + JKn("price", price) + "}");
        }
      else
         Enqueue("{" + Common(uidBase, "CLOSE") + "," + JKi("master_ticket", pos) + "," + JKs("symbol", sym) + "," + JKn("price", price) + "}");
     }
   else if(entry == DEAL_ENTRY_INOUT)
      Print("QT Master: lệnh đảo chiều (netting) chưa được hỗ trợ, deal ", deal);
  }

//--- SL/TP changes of an open position
void OnPositionChange(const MqlTradeTransaction &t)
  {
   if(!PositionSelectByTicket(t.position)) return;
   if(!MagicOk(PositionGetInteger(POSITION_MAGIC))) return;
   string uid = StringFormat("%I64d-MOD-%I64u-%I64u", g_login, t.position, GetMicrosecondCount());
   string e = "{" + Common(uid, "MODIFY") + "," + JKi("master_ticket", (long)t.position) + "," + JKs("symbol", t.symbol);
   if(t.price_sl > 0) e += "," + JKn("sl", t.price_sl);
   if(t.price_tp > 0) e += "," + JKn("tp", t.price_tp);
   Enqueue(e + "}");
  }

string PendingSide(ENUM_ORDER_TYPE t)
  {
   switch(t)
     {
      case ORDER_TYPE_BUY_LIMIT: return "BUY_LIMIT";
      case ORDER_TYPE_SELL_LIMIT: return "SELL_LIMIT";
      case ORDER_TYPE_BUY_STOP: return "BUY_STOP";
      case ORDER_TYPE_SELL_STOP: return "SELL_STOP";
     }
   return "";
  }

void OnPendingOrder(const MqlTradeTransaction &t)
  {
   string side = PendingSide(t.order_type);
   if(side == "") return;                                  // market orders arrive as deals
   string id = StringFormat("%I64d-ORD-%I64u", g_login, t.order);
   if(t.type == TRADE_TRANSACTION_ORDER_ADD)
     {
      string e = "{" + Common(id + "-ADD", "PENDING_PLACE") + "," + JKi("master_ticket", (long)t.order) + "," + JKs("symbol", t.symbol) + ","
                 + JKs("side", side) + "," + JKn("volume", t.volume) + "," + JKn("price", t.price) + ","
                 + JKn("master_balance", AccountInfoDouble(ACCOUNT_BALANCE)) + "," + JKn("master_equity", AccountInfoDouble(ACCOUNT_EQUITY)) + ","
                 + JKn("contract_size", SymbolInfoDouble(t.symbol, SYMBOL_TRADE_CONTRACT_SIZE));
      if(t.price_sl > 0) e += "," + JKn("sl", t.price_sl);
      if(t.price_tp > 0) e += "," + JKn("tp", t.price_tp);
      Enqueue(e + "}");
     }
   else if(t.type == TRADE_TRANSACTION_ORDER_UPDATE)
     {
      string e = "{" + Common(StringFormat("%s-UPD-%I64u", id, GetMicrosecondCount()), "PENDING_MODIFY") + "," + JKi("master_ticket", (long)t.order) + ","
                 + JKn("price", t.price);
      if(t.price_sl > 0) e += "," + JKn("sl", t.price_sl);
      if(t.price_tp > 0) e += "," + JKn("tp", t.price_tp);
      Enqueue(e + "}");
     }
   else if(t.order_state == ORDER_STATE_CANCELED || t.order_state == ORDER_STATE_EXPIRED || t.order_state == ORDER_STATE_REJECTED)
      // a FILLED pending order becomes a position: its deal sends OPEN with master_ticket = this order ticket
      Enqueue("{" + Common(id + "-DEL", "PENDING_DELETE") + "," + JKi("master_ticket", (long)t.order) + "}");
  }

//+------------------------------------------------------------------+
//| Timer: retry queue, snapshot, heartbeat, broker bars              |
//+------------------------------------------------------------------+
void OnTimer()
  {
   datetime now = TimeLocal();
   Flush();
   if(now - g_lastSnapshot >= InpSnapshotSec) { Snapshot(); g_lastSnapshot = now; Flush(); }
   if(now - g_lastHeartbeat >= InpHeartbeatSec) { Heartbeat(); g_lastHeartbeat = now; }
   if(ArrayRange(g_barMap, 0) > 0 && now - g_lastBars >= 60) { PushBars(); g_lastBars = now; }
   Comment(StringFormat("QT Master %s\nĐã gửi: %d sự kiện · hàng đợi: %d\n%s", QT_EA_VERSION, g_sent, ArraySize(g_queue), g_status));
  }

void Snapshot()
  {
   string list = "";
   for(int i = 0; i < PositionsTotal(); i++)
     {
      ulong tk = PositionGetTicket(i);
      if(tk == 0 || !MagicOk(PositionGetInteger(POSITION_MAGIC))) continue;
      string p = "{" + JKi("master_ticket", (long)tk) + "," + JKs("symbol", PositionGetString(POSITION_SYMBOL)) + ","
                 + JKs("side", PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY ? "BUY" : "SELL") + ","
                 + JKn("volume", PositionGetDouble(POSITION_VOLUME)) + "," + JKn("price", PositionGetDouble(POSITION_PRICE_OPEN));
      if(PositionGetDouble(POSITION_SL) > 0) p += "," + JKn("sl", PositionGetDouble(POSITION_SL));
      if(PositionGetDouble(POSITION_TP) > 0) p += "," + JKn("tp", PositionGetDouble(POSITION_TP));
      list += (list == "" ? "" : ",") + p + "}";
     }
   Enqueue("{" + Common(StringFormat("%I64d-SNAP-%I64d", g_login, QTNowMs()), "SNAPSHOT") + ",\"positions\":[" + list + "]}");
  }

void Heartbeat()
  {
   string resp;
   int code = g_api.Post("/ct-heartbeat", QTHeartbeatBody(g_status == "" ? "" : g_status), 8000, resp);
   if(code == 426) Alert("QT Master: cần cập nhật EA. ", g_api.lastError);
   if(code != 200) g_status = "Heartbeat lỗi: " + g_api.lastError;
   else if(StringFind(g_status, "Heartbeat") == 0) g_status = "";
  }

//+------------------------------------------------------------------+
//| Queue                                                             |
//+------------------------------------------------------------------+
void Enqueue(const string e)
  {
   int n = ArraySize(g_queue);
   if(n >= 5000) { Print("QT Master: hàng đợi đầy, bỏ sự kiện cũ nhất"); ArrayRemove(g_queue, 0, 1); n--; }
   ArrayResize(g_queue, n + 1);
   g_queue[n] = e;
  }

void Flush()
  {
   while(ArraySize(g_queue) > 0)
     {
      int k = MathMin(50, ArraySize(g_queue));
      string body = "{\"events\":[";
      for(int i = 0; i < k; i++) body += (i ? "," : "") + g_queue[i];
      body += "]}";
      string resp;
      int code = g_api.Post("/ct-ingest", body, 8000, resp);
      if(code == 200)
        {
         ArrayRemove(g_queue, 0, k);
         g_sent += k;
         g_status = "";
         continue;
        }
      if(code == 400)
        {
         // a malformed event would block the queue forever: log and drop this batch
         Print("QT Master: máy chủ từ chối sự kiện (400), bỏ qua: ", resp);
         ArrayRemove(g_queue, 0, k);
         continue;
        }
      g_status = "Gửi lỗi, sẽ thử lại: " + g_api.lastError;
      SaveQueue();
      return;
     }
   SaveQueue();
  }

void SaveQueue()
  {
   int h = FileOpen(QueueFile(), FILE_WRITE | FILE_TXT | FILE_ANSI);
   if(h == INVALID_HANDLE) return;
   for(int i = 0; i < ArraySize(g_queue); i++) FileWriteString(h, g_queue[i] + "\n");
   FileClose(h);
  }

void LoadQueue()
  {
   if(!FileIsExist(QueueFile())) return;
   int h = FileOpen(QueueFile(), FILE_READ | FILE_TXT | FILE_ANSI);
   if(h == INVALID_HANDLE) return;
   while(!FileIsEnding(h))
     {
      string line = FileReadString(h);
      if(StringLen(line) > 2) Enqueue(line);
     }
   FileClose(h);
   if(ArraySize(g_queue) > 0) Print("QT Master: gửi lại ", ArraySize(g_queue), " sự kiện chưa gửi từ lần chạy trước");
  }

//+------------------------------------------------------------------+
//| Broker M1 bars for the cloud chart                                |
//+------------------------------------------------------------------+
void ParseBarMap()
  {
   ArrayResize(g_barMap, 0);
   string parts[];
   int n = StringSplit(InpBarSymbols, ',', parts);
   for(int i = 0; i < n; i++)
     {
      string kv[];
      if(StringSplit(parts[i], '=', kv) != 2) continue;
      StringTrimLeft(kv[0]); StringTrimRight(kv[0]); StringTrimLeft(kv[1]); StringTrimRight(kv[1]);
      if(!QTSymbolExistsSimple(kv[1])) { Print("QT Master: không có symbol ", kv[1], " trên broker này, bỏ qua giá ", kv[0]); continue; }
      SymbolSelect(kv[1], true);
      int k = ArrayRange(g_barMap, 0);
      ArrayResize(g_barMap, k + 1);
      g_barMap[k][0] = kv[0];
      g_barMap[k][1] = kv[1];
     }
  }

bool QTSymbolExistsSimple(const string s) { bool custom = false; return SymbolExist(s, custom); }

void PushBars()
  {
   // broker server time -> UTC, rounded to 15 minutes
   int offset = (int)MathRound((double)(TimeTradeServer() - TimeGMT()) / 900.0) * 900;
   int count = g_barsBackfilled ? 3 : 120;   // server accepts 500 bars per call: 4 symbols x 120
   string list = "";
   for(int i = 0; i < ArrayRange(g_barMap, 0); i++)
     {
      MqlRates r[];
      int got = CopyRates(g_barMap[i][1], PERIOD_M1, 1, count, r);   // closed bars only
      for(int j = 0; j < got; j++)
         list += (list == "" ? "" : ",") + "{" + JKs("symbol", g_barMap[i][0]) + "," + JKi("t", (long)r[j].time - offset) + ","
                 + JKn("o", r[j].open) + "," + JKn("h", r[j].high) + "," + JKn("l", r[j].low) + "," + JKn("c", r[j].close) + ","
                 + JKn("v", (double)r[j].tick_volume) + "}";
     }
   if(list == "") return;
   string resp;
   if(g_api.Post("/ct-bars", "{\"bars\":[" + list + "]}", 8000, resp) == 200) g_barsBackfilled = true;
  }
//+------------------------------------------------------------------+
