# Copy to .env.local (local dev) and set the same names in Vercel → Project → Settings → Environment Variables.
# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only (never prefix with NEXT_PUBLIC_). Needed from Phase 1 for admin routes.
SUPABASE_SECRET_KEY=
