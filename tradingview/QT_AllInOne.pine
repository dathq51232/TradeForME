// Quant Terminal Cloud — same licence as this repository (see LICENSE).
// Quant Terminal — All-in-One (bộ cốt lõi)
// Port of the project's own chart reading (packages/core/src: trend.js, patterns.js, rsi-tools.js) to Pine v6,
// so it runs as ONE indicator on a free TradingView account:
//   1. Trend dài hạn: EMA50 / EMA200 on closed daily candles, a new state confirmed by two closes, golden/death cross
//   2. Bảng trend: gold, silver, WTI, Brent, Bitcoin in one table
//   3. Mô hình nến: hammer, engulfing, harami, morning/evening star, three soldiers/crows, tweezers, marubozu
//   4. RSI: trendlines on the RSI, regular and hidden divergence (drawn on RSI and on price), volume spikes
//   5. Mức giá: key levels from candle closes, previous day/week high-low-close, forex sessions
// The script lives in its own pane (the RSI); everything that belongs on the price chart uses force_overlay.
// Same rules as the web app, but Pine computes bar by bar, so results are close to the web chart, not identical.
// A reading aid, not trade signals.
//@version=6
indicator("QT All-in-One", shorttitle = "QT AIO", overlay = false, max_labels_count = 500, max_lines_count = 500,
     max_boxes_count = 50, max_bars_back = 600)

// ═════════════════════════════ inputs ═════════════════════════════
G_TR = "1 · Trend dài hạn"
trendTf     = input.timeframe("D", "Khung tính trend", group = G_TR, tooltip = "Trend dài hạn đọc trên nến đã đóng của khung này (mặc định nến ngày, như web app)")
fastLen     = input.int(50, "EMA nhanh", minval = 2, group = G_TR)
slowLen     = input.int(200, "EMA chậm", minval = 3, group = G_TR)
showEma     = input.bool(true, "Vẽ EMA nhanh / chậm lên biểu đồ giá", group = G_TR)
showTrMarks = input.bool(true, "Đánh dấu trend đổi chiều, golden / death cross", group = G_TR)
showTrBg    = input.bool(false, "Tô nền biểu đồ theo trend", group = G_TR)

G_TB = "2 · Bảng trend tài sản"
showTable = input.bool(true, "Hiện bảng", group = G_TB)
tablePos  = input.string("Trên phải", "Vị trí", options = ["Trên phải", "Trên trái", "Dưới phải", "Dưới trái"], group = G_TB)
sym1 = input.symbol("OANDA:XAUUSD", "Vàng", group = G_TB)
sym2 = input.symbol("OANDA:XAGUSD", "Bạc", group = G_TB)
sym3 = input.symbol("TVC:USOIL", "Dầu WTI", group = G_TB)
sym4 = input.symbol("TVC:UKOIL", "Dầu Brent", group = G_TB)
sym5 = input.symbol("BINANCE:BTCUSDT", "Bitcoin", group = G_TB)

G_CD = "3 · Mô hình nến"
showCandles  = input.bool(true, "Hiện mô hình nến", group = G_CD)
showMarubozu = input.bool(true, "Gồm Marubozu", group = G_CD)
showDoji     = input.bool(false, "Gồm Doji (rất nhiều)", group = G_CD)

G_RS = "4 · RSI, hội tụ / phân kỳ, volume"
showRsi    = input.bool(true, "Hiện RSI", group = G_RS)
rsiLen     = input.int(14, "RSI length", minval = 2, group = G_RS)
rsiSrc     = input.source(close, "RSI source", group = G_RS)
rsiMaLen   = input.int(14, "RSI MA (SMA, 0 = tắt)", minval = 0, group = G_RS)
showTl     = input.bool(true, "Trendline trên RSI", group = G_RS)
tlDepth    = input.int(3, "Trendline: độ mạnh pivot (nến mỗi bên)", minval = 1, maxval = 10, group = G_RS)
tlTol      = input.float(1.5, "Trendline: sai số chạm (điểm RSI)", minval = 0.1, group = G_RS)
showDiv    = input.bool(true, "Hội tụ / phân kỳ", group = G_RS)
divLeft    = input.int(5, "Phân kỳ: pivot nến trái", minval = 1, group = G_RS)
divRight   = input.int(5, "Phân kỳ: pivot nến phải", minval = 1, group = G_RS)
showHidden = input.bool(true, "Gồm hội tụ / phân kỳ ẩn", group = G_RS)
showVol    = input.bool(true, "Volume đột biến", group = G_RS)
volLen     = input.int(20, "Volume: trung bình N nến trước", minval = 2, group = G_RS)
volMult    = input.float(2.5, "Volume: đột biến khi ≥ × trung bình", minval = 1, group = G_RS)

G_LV = "5 · Mức giá và phiên"
showLevels = input.bool(true, "Key level từ giá đóng cửa", group = G_LV)
lvLookback = input.int(400, "Key level: số nến xét", minval = 50, maxval = 500, group = G_LV)
lvMax      = input.int(8, "Key level: tối đa", minval = 1, maxval = 20, group = G_LV)
lvDepth    = input.int(3, "Key level: độ mạnh swing", minval = 1, maxval = 10, group = G_LV)
showPrev   = input.bool(true, "Đỉnh / đáy / đóng cửa ngày, tuần trước; đóng cửa tháng trước", group = G_LV)
showSess   = input.bool(true, "Phiên giao dịch (khung ≤ H1)", group = G_LV)
sessSyd    = input.bool(false, "Sydney", inline = "ss", group = G_LV)
sessTok    = input.bool(true, "Tokyo", inline = "ss", group = G_LV)
sessLon    = input.bool(true, "London", inline = "ss", group = G_LV)
sessNy     = input.bool(true, "New York", inline = "ss", group = G_LV)

G_ST = "Hiển thị"
showText = input.bool(true, "Hiện chữ (tắt = chỉ mũi tên, rê chuột để xem tên)", group = G_ST)

C_UP   = #00c087
C_DOWN = #f45b69
C_SIDE = #f5a142
C_MUTE = #8292a8

// ═════════════════════════════ 1 · trend dài hạn ═════════════════════════════
// trend.js: up = EMA fast above EMA slow and close above EMA slow; down mirrored; otherwise sideways.
// A new state counts once two closes in a row agree on it.
f_trend() =>
    float ef = ta.ema(close, fastLen)
    float es = ta.ema(close, slowLen)
    int raw = na(es) or na(ef) ? na : ef > es and close > es ? 1 : ef < es and close < es ? -1 : 0
    var int st = na
    if not na(raw)
        if na(st)
            st := raw
        else if raw != st and raw == raw[1]
            st := raw
    var float since = na
    if not na(st) and (na(st[1]) or st != st[1])
        since := time
    float dist  = na(es) ? na : (close - es) / es * 100
    float slope = na(es[20]) ? na : (es - es[20]) / es[20] * 100
    [st, ef, es, dist, slope, since, close]

// the last CLOSED candle of the trend timeframe (no repaint): value one bar back, read with lookahead
f_closed() =>
    [st, ef, es, dist, slope, since, c] = f_trend()
    [st[1], ef[1], es[1], dist[1], slope[1], since[1], c[1]]

[dSt, dEf, dEs, dDist, dSlope, dSince, dClose] = f_trend()
[hSt, hEf, hEs, hDist, hSlope, hSince, hClose] = request.security(syminfo.tickerid, trendTf, f_closed(), lookahead = barmerge.lookahead_on)
bool sameTf = timeframe.in_seconds() == timeframe.in_seconds(trendTf)
// on the trend timeframe itself, read the chart's own bars (events wait for the candle to close)
int   trSt    = sameTf ? dSt : hSt
float trEf    = sameTf ? dEf : hEf
float trEs    = sameTf ? dEs : hEs
float trClose = sameTf ? dClose : hClose

bool newHtf   = sameTf ? barstate.isconfirmed : trEs != trEs[1] or trClose != trClose[1]
bool trChange = newHtf and not na(trSt) and not na(trSt[1]) and trSt != trSt[1]
bool trUp     = trChange and trSt == 1
bool trDown   = trChange and trSt == -1
bool trSide   = trChange and trSt == 0
bool golden   = newHtf and trEf > trEs and trEf[1] <= trEs[1]
bool death    = newHtf and trEf < trEs and trEf[1] >= trEs[1]
bool aboveE   = newHtf and trClose > trEs and trClose[1] <= trEs[1]
bool belowE   = newHtf and trClose < trEs and trClose[1] >= trEs[1]

plot(showEma ? trEf : na, "EMA nhanh (trend)", color.new(C_SIDE, 0), 1, plot.style_stepline, force_overlay = true)
plot(showEma ? trEs : na, "EMA chậm (trend)", color.new(#4f8cff, 0), 2, plot.style_stepline, force_overlay = true)
bgcolor(showTrBg and not na(trSt) ? (trSt == 1 ? color.new(C_UP, 93) : trSt == -1 ? color.new(C_DOWN, 93) : color.new(C_SIDE, 95)) : na, title = "Nền trend", force_overlay = true)
plotshape(showTrMarks and golden, "Golden cross", shape.triangleup, location.belowbar, C_UP, size = size.small, text = "GC", textcolor = C_UP, force_overlay = true)
plotshape(showTrMarks and death, "Death cross", shape.triangledown, location.abovebar, C_DOWN, size = size.small, text = "DC", textcolor = C_DOWN, force_overlay = true)
plotshape(showTrMarks and trUp, "Trend chuyển tăng", shape.labelup, location.belowbar, color.new(C_UP, 20), size = size.tiny, text = "Trend ▲", textcolor = color.white, force_overlay = true)
plotshape(showTrMarks and trDown, "Trend chuyển giảm", shape.labeldown, location.abovebar, color.new(C_DOWN, 20), size = size.tiny, text = "Trend ▼", textcolor = color.white, force_overlay = true)
plotshape(showTrMarks and trSide, "Trend chuyển đi ngang", shape.diamond, location.abovebar, C_SIDE, size = size.tiny, force_overlay = true)

// ═════════════════════════════ 2 · bảng trend ═════════════════════════════
[s1St, e1, es1, s1Dist, s1Slope, s1Since, c1] = request.security(sym1, trendTf, f_closed(), lookahead = barmerge.lookahead_on)
[s2St, e2, es2, s2Dist, s2Slope, s2Since, c2] = request.security(sym2, trendTf, f_closed(), lookahead = barmerge.lookahead_on)
[s3St, e3, es3, s3Dist, s3Slope, s3Since, c3] = request.security(sym3, trendTf, f_closed(), lookahead = barmerge.lookahead_on)
[s4St, e4, es4, s4Dist, s4Slope, s4Since, c4] = request.security(sym4, trendTf, f_closed(), lookahead = barmerge.lookahead_on)
[s5St, e5, es5, s5Dist, s5Slope, s5Since, c5] = request.security(sym5, trendTf, f_closed(), lookahead = barmerge.lookahead_on)

f_stText(int st) => na(st) ? "Chưa đủ dữ liệu" : st == 1 ? "▲ Tăng dài hạn" : st == -1 ? "▼ Giảm dài hạn" : "◆ Đi ngang"
f_stColor(int st) => na(st) ? C_MUTE : st == 1 ? C_UP : st == -1 ? C_DOWN : C_SIDE
f_pct(float v) => na(v) ? "—" : (v >= 0 ? "+" : "") + str.tostring(v, "0.0") + "%"
f_name(string s) =>
    array<string> parts = str.split(s, ":")
    array.size(parts) > 1 ? array.get(parts, 1) : s
f_row(table t, int r, string name, int st, float dist, float slope, float since) =>
    string tip = na(since) ? "" : "Từ " + str.format_time(int(since), "dd/MM/yyyy", "UTC")
    table.cell(t, 0, r, name, text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, r, f_stText(st), text_color = f_stColor(st), text_size = size.small, text_halign = text.align_left, tooltip = tip)
    table.cell(t, 2, r, f_pct(dist), text_color = color.white, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 3, r, f_pct(slope), text_color = color.white, text_size = size.small, text_halign = text.align_right)

var table tb = table.new(tablePos == "Trên phải" ? position.top_right : tablePos == "Trên trái" ? position.top_left : tablePos == "Dưới phải" ? position.bottom_right : position.bottom_left,
     4, 8, bgcolor = color.new(#0f1520, 10), border_color = color.new(C_MUTE, 70), border_width = 1, force_overlay = true)
if showTable and barstate.islast
    table.cell(tb, 0, 0, "Mã", text_color = C_MUTE, text_size = size.small)
    table.cell(tb, 1, 0, "Trend dài hạn (" + trendTf + ")", text_color = C_MUTE, text_size = size.small)
    table.cell(tb, 2, 0, "vs EMA" + str.tostring(slowLen), text_color = C_MUTE, text_size = size.small)
    table.cell(tb, 3, 0, "Dốc 20p", text_color = C_MUTE, text_size = size.small)
    f_row(tb, 1, syminfo.ticker + " (biểu đồ)", trSt, sameTf ? dDist : hDist, sameTf ? dSlope : hSlope, sameTf ? dSince : hSince)
    f_row(tb, 2, f_name(sym1), s1St, s1Dist, s1Slope, s1Since)
    f_row(tb, 3, f_name(sym2), s2St, s2Dist, s2Slope, s2Since)
    f_row(tb, 4, f_name(sym3), s3St, s3Dist, s3Slope, s3Since)
    f_row(tb, 5, f_name(sym4), s4St, s4Dist, s4Slope, s4Since)
    f_row(tb, 6, f_name(sym5), s5St, s5Dist, s5Slope, s5Since)
    table.cell(tb, 0, 7, "Cần " + str.tostring(slowLen) + " nến " + trendTf + " trong lịch sử biểu đồ; khung nhỏ có thể thiếu → mở H4 / D1.", text_color = C_MUTE, text_size = size.tiny, text_halign = text.align_left)
    table.merge_cells(tb, 0, 7, 3, 7)

// ═════════════════════════════ 3 · mô hình nến ═════════════════════════════
// patterns.js candlestickPatterns: at most one per bar (three-bar, then two-bar, then one-bar). Reversals need the
// trend they reverse: the close before the pattern below (above) both its 10-bar average and the close 5 bars earlier.
float atrC = ta.atr(14)
float avgRange = ta.cum(high - low) / (bar_index + 1)
float aC   = na(atrC) or atrC <= 0 ? avgRange : atrC
float sma10 = ta.sma(close, 10)[1]

f_body(float o, float c) => math.abs(c - o)
f_upW(float h, float o, float c) => h - math.max(o, c)
f_loW(float l, float o, float c) => math.min(o, c) - l

string cKind = ""
int cBias = 0
if showCandles and bar_index >= 10 and barstate.isconfirmed
    float ref = close[1]
    float five = close[6]
    float before3 = close[3]
    bool dn  = ref < sma10 and ref < five
    bool up  = ref > sma10 and ref > five
    bool dn3 = before3 < five
    bool up3 = before3 > five
    float bB = f_body(open, close)
    float bP = f_body(open[1], close[1])
    float bQ = f_body(open[2], close[2])
    bool gB = close > open
    bool gP = close[1] > open[1]
    bool gQ = close[2] > open[2]
    bool rB = close < open
    bool rP = close[1] < open[1]
    bool rQ = close[2] < open[2]
    float midQ = (open[2] + close[2]) / 2
    float midP = (open[1] + close[1]) / 2
    float rng = high - low
    float a = aC
    bool soldiers = gQ and gP and gB and close[1] > close[2] and close > close[1]
         and bQ >= 0.5 * a and bP >= 0.5 * a and bB >= 0.5 * a
         and f_upW(high[2], open[2], close[2]) <= 0.3 * bQ and f_upW(high[1], open[1], close[1]) <= 0.3 * bP and f_upW(high, open, close) <= 0.3 * bB
         and open[1] >= open[2] and open[1] <= close[2] and open >= open[1] and open <= close[1]
    bool crows = rQ and rP and rB and close[1] < close[2] and close < close[1]
         and bQ >= 0.5 * a and bP >= 0.5 * a and bB >= 0.5 * a
         and f_loW(low[2], open[2], close[2]) <= 0.3 * bQ and f_loW(low[1], open[1], close[1]) <= 0.3 * bP and f_loW(low, open, close) <= 0.3 * bB
         and open[1] <= open[2] and open[1] >= close[2] and open <= open[1] and open >= close[1]
    if dn3 and rQ and bQ >= 0.8 * a and bP <= 0.35 * bQ and gB and close > midQ
        cKind := "Sao mai"
    else if up3 and gQ and bQ >= 0.8 * a and bP <= 0.35 * bQ and rB and close < midQ
        cKind := "Sao hôm"
    else if soldiers
        cKind := "Ba chàng lính"
    else if crows
        cKind := "Ba con quạ"
    else if dn and rP and gB and close >= open[1] and open <= close[1] and bB > bP and bB >= 0.5 * a
        cKind := "Nhấn chìm tăng"
    else if up and gP and rB and close <= open[1] and open >= close[1] and bB > bP and bB >= 0.5 * a
        cKind := "Nhấn chìm giảm"
    else if dn and rP and bP >= a and gB and open <= close[1] and close > midP and close < open[1]
        cKind := "Xuyên thủng"
    else if up and gP and bP >= a and rB and open >= close[1] and close < midP and close > open[1]
        cKind := "Mây đen che phủ"
    else if dn and rP and bP >= a and gB and bB <= 0.5 * bP and open >= close[1] and close <= open[1]
        cKind := "Harami tăng"
    else if up and gP and bP >= a and rB and bB <= 0.5 * bP and open <= close[1] and close >= open[1]
        cKind := "Harami giảm"
    else if dn and rP and gB and math.abs(low - low[1]) <= 0.05 * a and bP >= 0.4 * a and bB >= 0.4 * a
        cKind := "Đáy nhíp"
    else if up and gP and rB and math.abs(high - high[1]) <= 0.05 * a and bP >= 0.4 * a and bB >= 0.4 * a
        cKind := "Đỉnh nhíp"
    else if rng >= 0.6 * a and f_loW(low, open, close) >= 2 * bB and f_upW(high, open, close) <= 0.15 * rng and bB >= 0.05 * rng
        cKind := dn ? "Búa" : up ? "Người treo cổ" : ""
    else if rng >= 0.6 * a and f_upW(high, open, close) >= 2 * bB and f_loW(low, open, close) <= 0.15 * rng and bB >= 0.05 * rng
        cKind := dn ? "Búa ngược" : up ? "Sao băng" : ""
    else if rng >= 1.2 * a and bB >= 0.9 * rng
        cKind := showMarubozu ? (gB ? "Marubozu tăng" : "Marubozu giảm") : ""
    else if showDoji and rng >= 0.5 * a and bB <= 0.1 * rng
        cKind := "Doji"
    if cKind != ""
        cBias := cKind == "Doji" ? 0 : (cKind == "Búa" or cKind == "Búa ngược" or cKind == "Nhấn chìm tăng" or cKind == "Harami tăng" or cKind == "Xuyên thủng"
             or cKind == "Sao mai" or cKind == "Ba chàng lính" or cKind == "Đáy nhíp" or cKind == "Marubozu tăng") ? 1 : -1
        color cc = cBias > 0 ? C_UP : cBias < 0 ? C_DOWN : C_MUTE
        if showText
            label.new(bar_index, cBias > 0 ? low : high, cKind, yloc = cBias > 0 ? yloc.belowbar : yloc.abovebar,
                 style = cBias > 0 ? label.style_label_up : label.style_label_down, color = color.new(cc, 100), textcolor = cc, size = size.small, tooltip = cKind, force_overlay = true)
        else
            label.new(bar_index, cBias > 0 ? low : high, "", yloc = cBias > 0 ? yloc.belowbar : yloc.abovebar,
                 style = cBias > 0 ? label.style_triangleup : label.style_triangledown, color = cc, size = size.tiny, tooltip = cKind, force_overlay = true)

// reversal patterns for alerts (marubozu and doji are left out, like the web app's Telegram alerts)
bool candleBull = cBias == 1 and not str.contains(cKind, "Marubozu")
bool candleBear = cBias == -1 and not str.contains(cKind, "Marubozu")

// ═════════════════════════════ 4 · RSI ═════════════════════════════
float rsiV  = ta.rsi(rsiSrc, rsiLen)
float rsiMa = rsiMaLen > 0 ? ta.sma(rsiV, rsiMaLen) : na
plot(showRsi ? rsiV : na, "RSI", #7e57c2, 2)
plot(showRsi ? rsiMa : na, "RSI MA", #f7c600, 1)
hline(70, "70", color.new(C_MUTE, 50), hline.style_dashed, display = showRsi ? display.all : display.none)
hline(50, "50", color.new(C_MUTE, 75), hline.style_dotted, display = showRsi ? display.all : display.none)
hline(30, "30", color.new(C_MUTE, 50), hline.style_dashed, display = showRsi ? display.all : display.none)

// ---- trendlines on the RSI (rsi-tools.js oscTrendlines, run bar by bar) ----
// A resistance joins two RSI pivot highs with every value between them under the line (within the tolerance),
// at most 4 pivots apart, 6 to 90 bars long, no steeper than 0.6 RSI points a bar; it runs on until the RSI closes
// more than 1 point through it, or for as long again as the two touches span. Supports mirror it on the lows.
TL_MIN_SPAN = 6
TL_MAX_SPAN = 90
TL_MAX_SLOPE = 0.6
TL_BREAK = 1.0

type TLine
    line ln
    int side      // +1 resistance (values stay under), -1 support
    int i1
    float v1
    float slope
    int limit
    int touches

var array<TLine> tlActive = array.new<TLine>()
var array<int>   phI = array.new<int>()
var array<float> phV = array.new<float>()
var array<int>   plI = array.new<int>()
var array<float> plV = array.new<float>()
bool rsiBreakUp = false
bool rsiBreakDown = false

f_tryLine(int side, array<int> pI, array<float> pV, int i2, float v2) =>
    int n = array.size(pI)
    int bestI1 = na
    float bestV1 = na
    int bestTouches = 0
    int bestSpan = 0
    if n > 0
        for a = n - 1 to math.max(0, n - 4)
            int i1 = array.get(pI, a)
            float v1 = array.get(pV, a)
            int span = i2 - i1
            if span > TL_MAX_SPAN
                break
            if span >= TL_MIN_SPAN
                float slope = (v2 - v1) / span
                if math.abs(slope) <= TL_MAX_SLOPE
                    bool ok = true
                    for k = i1 + 1 to i2 - 1
                        float val = rsiV[bar_index - k]
                        if not na(val) and side * (val - (v1 + slope * (k - i1))) > tlTol
                            ok := false
                            break
                    if ok
                        int touches = 1  // the new pivot itself
                        for m = 0 to n - 1
                            int im = array.get(pI, m)
                            if im >= i1 and im <= i2 and math.abs(array.get(pV, m) - (v1 + slope * (im - i1))) <= tlTol
                                touches += 1
                        if touches > bestTouches or (touches == bestTouches and span > bestSpan)
                            bestTouches := touches
                            bestSpan := span
                            bestI1 := i1
                            bestV1 := v1
    [bestI1, bestV1, bestTouches, bestSpan]

f_addLine(int side, int i1, float v1, int i2, float v2, int touches, int span) =>
    float slope = (v2 - v1) / span
    int limit = i2 + math.max(span, 12)
    // the pivot is confirmed tlDepth bars late: the RSI may already have broken the line meanwhile
    int brokeAt = na
    for k = i2 + 1 to bar_index
        float val = rsiV[bar_index - k]
        if not na(val) and side * (val - (v1 + slope * (k - i1))) > TL_BREAK
            brokeAt := k
            break
    float lo = v1 + slope * (limit - i1)
    bool inRange = math.min(v1, lo) >= 0 and math.max(v1, lo) <= 100
    if na(brokeAt) and inRange
        // a line overlapping most of an active one on the same side: keep the one with more touches
        bool keep = true
        int sz = array.size(tlActive)
        if sz > 0
            for j = sz - 1 to 0
                TLine t = array.get(tlActive, j)
                if t.side == side
                    int ov = math.min(t.limit, limit) - math.max(t.i1, i1)
                    if ov > 0.4 * math.min(t.limit - t.i1, limit - i1)
                        if touches > t.touches
                            line.delete(t.ln)
                            array.remove(tlActive, j)
                        else
                            keep := false
        if keep
            color c = side == 1 ? #ef5350 : #26a69a
            line ln = line.new(i1, v1, bar_index, v1 + slope * (bar_index - i1), color = c, width = 2)
            array.push(tlActive, TLine.new(ln, side, i1, v1, slope, limit, touches))

float rPh = ta.pivothigh(rsiV, tlDepth, tlDepth)
float rPl = ta.pivotlow(rsiV, tlDepth, tlDepth)
if showRsi and showTl
    // extend, break or retire the active lines
    int sz = array.size(tlActive)
    if sz > 0
        for j = sz - 1 to 0
            TLine t = array.get(tlActive, j)
            float at = t.v1 + t.slope * (bar_index - t.i1)
            if not na(rsiV) and t.side * (rsiV - at) > TL_BREAK
                line.set_xy2(t.ln, bar_index, at)
                if t.side == 1
                    rsiBreakUp := true
                else
                    rsiBreakDown := true
                array.remove(tlActive, j)
            else if bar_index >= t.limit
                line.set_xy2(t.ln, t.limit, t.v1 + t.slope * (t.limit - t.i1))
                array.remove(tlActive, j)
            else
                line.set_xy2(t.ln, bar_index, at)
    if not na(rPh)
        int i2 = bar_index - tlDepth
        [b1, bv, bt, bs] = f_tryLine(1, phI, phV, i2, rPh)
        if not na(b1)
            f_addLine(1, b1, bv, i2, rPh, bt, bs)
        array.push(phI, i2)
        array.push(phV, rPh)
        if array.size(phI) > 30
            array.shift(phI)
            array.shift(phV)
    if not na(rPl)
        int i2 = bar_index - tlDepth
        [b1, bv, bt, bs] = f_tryLine(-1, plI, plV, i2, rPl)
        if not na(b1)
            f_addLine(-1, b1, bv, i2, rPl, bt, bs)
        array.push(plI, i2)
        array.push(plV, rPl)
        if array.size(plI) > 30
            array.shift(plI)
            array.shift(plV)
plotshape(showRsi and showTl and rsiBreakUp ? rsiV : na, "RSI phá trendline lên", shape.circle, location.absolute, C_UP, size = size.tiny)
plotshape(showRsi and showTl and rsiBreakDown ? rsiV : na, "RSI phá trendline xuống", shape.circle, location.absolute, C_DOWN, size = size.tiny)

// ---- divergence (rsi-tools.js divergences): consecutive RSI pivots 5 to 60 bars apart, RSI difference ≥ 1 ----
// Price is the bar's low at RSI pivot lows and its high at RSI pivot highs. Known `divRight` bars after the pivot.
DIV_MIN_GAP = 5
DIV_MAX_GAP = 60
var int   dLowI = na
var float dLowR = na
var float dLowP = na
var int   dHighI = na
var float dHighR = na
var float dHighP = na
bool divBull = false
bool divBear = false
bool divHBull = false
bool divHBear = false

f_drawDiv(int i1, float r1, float p1, int i2, float r2, float p2, string name, color c, bool bull) =>
    line.new(i1, r1, i2, r2, color = c, width = 2, style = line.style_dashed)
    line.new(i1, p1, i2, p2, color = c, width = 2, style = line.style_dashed, force_overlay = true)
    label.new(i2, p2, showText ? name : "", yloc = bull ? yloc.belowbar : yloc.abovebar,
         style = showText ? (bull ? label.style_label_up : label.style_label_down) : (bull ? label.style_triangleup : label.style_triangledown),
         color = showText ? color.new(c, 100) : c, textcolor = c, size = showText ? size.small : size.tiny, tooltip = name, force_overlay = true)

float dPl = ta.pivotlow(rsiV, divLeft, divRight)
float dPh = ta.pivothigh(rsiV, divLeft, divRight)
if showDiv and not na(dPl)
    int i2 = bar_index - divRight
    float p2 = low[divRight]
    if not na(dLowI)
        int gap = i2 - dLowI
        float dr = dPl - dLowR
        if gap >= DIV_MIN_GAP and gap <= DIV_MAX_GAP and math.abs(dr) >= 1
            if p2 < dLowP and dr > 0
                divBull := true
                f_drawDiv(dLowI, dLowR, dLowP, i2, dPl, p2, "Hội tụ", #22c55e, true)
            else if showHidden and p2 > dLowP and dr < 0
                divHBull := true
                f_drawDiv(dLowI, dLowR, dLowP, i2, dPl, p2, "Hội tụ ẩn", color.new(#22c55e, 40), true)
    dLowI := i2
    dLowR := dPl
    dLowP := p2
if showDiv and not na(dPh)
    int i2 = bar_index - divRight
    float p2 = high[divRight]
    if not na(dHighI)
        int gap = i2 - dHighI
        float dr = dPh - dHighR
        if gap >= DIV_MIN_GAP and gap <= DIV_MAX_GAP and math.abs(dr) >= 1
            if p2 > dHighP and dr < 0
                divBear := true
                f_drawDiv(dHighI, dHighR, dHighP, i2, dPh, p2, "Phân kỳ", #f43f5e, false)
            else if showHidden and p2 < dHighP and dr > 0
                divHBear := true
                f_drawDiv(dHighI, dHighR, dHighP, i2, dPh, p2, "Phân kỳ ẩn", color.new(#f43f5e, 40), false)
    dHighI := i2
    dHighR := dPh
    dHighP := p2

// ---- volume spikes (rsi-tools.js volumeSpikes): volume ≥ mult × the average of the bars before ----
float volAvg = ta.sma(volume, volLen)[1]
bool volSpike = showVol and barstate.isconfirmed and not na(volume) and volAvg > 0 and volume >= volMult * volAvg
if volSpike
    bool vUp = close >= open
    string vTxt = "Vol ×" + str.tostring(volume / volAvg, "0.0")
    color vc = vUp ? #26a69a : #ef5350
    label.new(bar_index, vUp ? low : high, showText ? vTxt : "", yloc = vUp ? yloc.belowbar : yloc.abovebar,
         style = showText ? label.style_none : label.style_diamond, color = vc, textcolor = vc, size = size.tiny, tooltip = vTxt, force_overlay = true)

// ═════════════════════════════ 5 · mức giá và phiên ═════════════════════════════
// ---- key levels (patterns.js closeLevels) ----
// Closes at swing points (on the close series) grouped within 0.35 ATR; a level needs two swing closes.
// Score = 2 per swing close + 0.5 per other close near it + 2 if used in the last quarter of the window.
// Strongest first; a weaker level closer than max(1.2 ATR, 4% of the window's range) to a stronger one is dropped.
var array<line>  lvLines  = array.new<line>()
var array<label> lvLabels = array.new<label>()
float winHi = ta.highest(high, lvLookback)
float winLo = ta.lowest(low, lvLookback)
if showLevels and barstate.islast
    for ln in lvLines
        line.delete(ln)
    for lb in lvLabels
        label.delete(lb)
    array.clear(lvLines)
    array.clear(lvLabels)
    int N = math.min(lvLookback, bar_index + 1)
    float tol = 0.35 * aC
    // swing closes: offset j bars back, older bars at j + k, newer at j - k
    array<float> cP = array.new<float>()
    array<int>   cJ = array.new<int>()
    if N > lvDepth * 2 + 5
        for j = lvDepth to N - 1 - lvDepth
            float v = close[j]
            bool hi = true
            bool lo = true
            for k = 1 to lvDepth
                if close[j + k] >= v or close[j - k] > v
                    hi := false
                if close[j + k] <= v or close[j - k] < v
                    lo := false
            if hi or lo
                array.push(cP, v)
                array.push(cJ, j)
    int nc = array.size(cP)
    // clusters over the candidates sorted by price
    array<float> kSum = array.new<float>()
    array<int>   kCnt = array.new<int>()
    array<int>   kMinJ = array.new<int>()
    array<int>   kMaxJ = array.new<int>()
    array<int>   kOf = array.new<int>(nc, 0)
    if nc > 0
        array<int> ord = array.sort_indices(cP, order.ascending)
        float lowest = na
        for q = 0 to nc - 1
            int ix = array.get(ord, q)
            float p = array.get(cP, ix)
            int j = array.get(cJ, ix)
            if na(lowest) or p - lowest > tol
                lowest := p
                array.push(kSum, 0.0)
                array.push(kCnt, 0)
                array.push(kMinJ, j)
                array.push(kMaxJ, j)
            int c = array.size(kSum) - 1
            array.set(kOf, ix, c)
            array.set(kSum, c, array.get(kSum, c) + p)
            array.set(kCnt, c, array.get(kCnt, c) + 1)
            array.set(kMinJ, c, math.min(array.get(kMinJ, c), j))
            array.set(kMaxJ, c, math.max(array.get(kMaxJ, c), j))
    int nk = array.size(kSum)
    array<float> lvP = array.new<float>()
    array<float> lvS = array.new<float>()
    array<int>   lvFirst = array.new<int>()
    if nk > 0
        int recentJ = int(math.floor(N * 0.25))
        for c = 0 to nk - 1
            int cnt = array.get(kCnt, c)
            if cnt >= 2
                float price = array.get(kSum, c) / cnt
                int touches = 0
                for j = 0 to N - 1
                    if math.abs(close[j] - price) <= tol / 2
                        touches += 1
                // the swing closes themselves are not extra touches
                for q = 0 to nc - 1
                    if array.get(kOf, q) == c and math.abs(array.get(cP, q) - price) <= tol / 2
                        touches -= 1
                array.push(lvP, price)
                array.push(lvS, cnt * 2 + touches * 0.5 + (array.get(kMinJ, c) <= recentJ ? 2 : 0))
                array.push(lvFirst, array.get(kMaxJ, c))
    int nl = array.size(lvP)
    if nl > 0
        float gap = math.max(tol * 1.5, aC * 1.2, (winHi - winLo) * 0.04)
        array<int> byScore = array.sort_indices(lvS, order.descending)
        array<int> top = array.new<int>()
        for q = 0 to nl - 1
            if array.size(top) >= lvMax
                break
            int ix = array.get(byScore, q)
            bool far = true
            for t in top
                if math.abs(array.get(lvP, t) - array.get(lvP, ix)) <= gap
                    far := false
            if far
                array.push(top, ix)
        int nt = array.size(top)
        array<float> sc = array.new<float>()
        for t in top
            array.push(sc, array.get(lvS, t))
        array.sort(sc, order.descending)
        float cut1 = array.get(sc, int(math.floor(nt / 3.0)))
        float cut2 = array.get(sc, math.min(nt - 1, int(math.floor(nt * 2 / 3.0))))
        for t in top
            float price = array.get(lvP, t)
            float s = array.get(lvS, t)
            int strength = s > cut1 ? 3 : s > cut2 ? 2 : 1
            bool res = price >= close
            color c = res ? C_DOWN : C_UP
            array.push(lvLines, line.new(bar_index - array.get(lvFirst, t), price, bar_index, price, extend = extend.right,
                 color = color.new(c, 75 - strength * 15), width = strength, force_overlay = true))
            array.push(lvLabels, label.new(bar_index + 2, price, (res ? "Kháng cự " : "Hỗ trợ ") + str.repeat("●", strength),
                 style = label.style_label_left, color = color.new(c, 100), textcolor = color.new(c, 20), size = size.tiny,
                 tooltip = (res ? "Kháng cự" : "Hỗ trợ") + " " + str.tostring(price, format.mintick), force_overlay = true))

// ---- previous day / week high, low, close; previous month close ----
[pdH, pdL, pdC] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]], lookahead = barmerge.lookahead_on)
[pwH, pwL, pwC] = request.security(syminfo.tickerid, "W", [high[1], low[1], close[1]], lookahead = barmerge.lookahead_on)
pmC = request.security(syminfo.tickerid, "M", close[1], lookahead = barmerge.lookahead_on)
var int dStart = na
var int wStart = na
var int mStart = na
if timeframe.change("D")
    dStart := bar_index
if timeframe.change("W")
    wStart := bar_index
if timeframe.change("M")
    mStart := bar_index
var array<line>  pvLines  = array.new<line>()
var array<label> pvLabels = array.new<label>()
f_prevLine(array<line> ls, array<label> lbs, int x1, float y, string tag, string tip, color c) =>
    if not na(y) and not na(x1)
        array.push(ls, line.new(x1, y, bar_index, y, extend = extend.right, color = color.new(c, 30), style = line.style_dotted, force_overlay = true))
        array.push(lbs, label.new(bar_index + 2, y, tag, style = label.style_label_left, color = color.new(c, 100), textcolor = c,
             size = size.tiny, tooltip = tip + " " + str.tostring(y, format.mintick), force_overlay = true))
if showPrev and barstate.islast
    for ln in pvLines
        line.delete(ln)
    for lb in pvLabels
        label.delete(lb)
    array.clear(pvLines)
    array.clear(pvLabels)
    int sec = timeframe.in_seconds()
    if sec < 86400
        f_prevLine(pvLines, pvLabels, dStart, pdH, "PDH", "Đỉnh ngày trước", C_DOWN)
        f_prevLine(pvLines, pvLabels, dStart, pdL, "PDL", "Đáy ngày trước", C_UP)
        f_prevLine(pvLines, pvLabels, dStart, pdC, "PDC", "Đóng cửa ngày trước", C_MUTE)
    if sec < 604800
        f_prevLine(pvLines, pvLabels, wStart, pwH, "PWH", "Đỉnh tuần trước", C_DOWN)
        f_prevLine(pvLines, pvLabels, wStart, pwL, "PWL", "Đáy tuần trước", C_UP)
        f_prevLine(pvLines, pvLabels, wStart, pwC, "PWC", "Đóng cửa tuần trước", C_MUTE)
    f_prevLine(pvLines, pvLabels, mStart, pmC, "PMC", "Đóng cửa tháng trước", #c58af9)

// ---- forex sessions (patterns.js SESSIONS, local hours so daylight saving moves them on its own), Mon–Fri ----
bool intraOk = timeframe.isintraday and timeframe.in_seconds() <= 3600
f_in(string sess, string tz) => not na(time(timeframe.period, sess, tz))
bool inSyd = showSess and sessSyd and intraOk and f_in("0700-1600:23456", "Australia/Sydney")
bool inTok = showSess and sessTok and intraOk and f_in("0900-1800:23456", "Asia/Tokyo")
bool inLon = showSess and sessLon and intraOk and f_in("0800-1700:23456", "Europe/London")
bool inNy  = showSess and sessNy and intraOk and f_in("0800-1700:23456", "America/New_York")
bgcolor(inSyd ? color.new(#c58af9, 94) : na, title = "Phiên Sydney", force_overlay = true)
bgcolor(inTok ? color.new(#f5a142, 94) : na, title = "Phiên Tokyo", force_overlay = true)
bgcolor(inLon ? color.new(#4f8cff, 94) : na, title = "Phiên London", force_overlay = true)
bgcolor(inNy ? color.new(#00c087, 94) : na, title = "Phiên New York", force_overlay = true)

// ═════════════════════════════ alerts ═════════════════════════════
// Create them from the chart's alert dialog: Condition = "QT AIO" → pick one. Each fires on a closed candle.
alertcondition(trUp, "Trend dài hạn chuyển TĂNG", "{{ticker}}: trend dài hạn chuyển sang TĂNG (EMA50/EMA200, nến đã đóng). Giá {{close}}")
alertcondition(trDown, "Trend dài hạn chuyển GIẢM", "{{ticker}}: trend dài hạn chuyển sang GIẢM (EMA50/EMA200, nến đã đóng). Giá {{close}}")
alertcondition(trSide, "Trend dài hạn chuyển ĐI NGANG", "{{ticker}}: trend dài hạn chuyển sang ĐI NGANG. Giá {{close}}")
alertcondition(golden, "Golden cross", "{{ticker}}: Golden cross — EMA50 cắt lên EMA200. Giá {{close}}")
alertcondition(death, "Death cross", "{{ticker}}: Death cross — EMA50 cắt xuống EMA200. Giá {{close}}")
alertcondition(aboveE, "Giá đóng cửa vượt EMA200", "{{ticker}}: giá đóng cửa vượt lên EMA200. Giá {{close}}")
alertcondition(belowE, "Giá đóng cửa thủng EMA200", "{{ticker}}: giá đóng cửa thủng xuống EMA200. Giá {{close}}")
alertcondition(candleBull, "Mô hình nến tăng", "{{ticker}} {{interval}}: mô hình nến đảo chiều tăng. Đóng cửa {{close}}")
alertcondition(candleBear, "Mô hình nến giảm", "{{ticker}} {{interval}}: mô hình nến đảo chiều giảm. Đóng cửa {{close}}")
alertcondition(divBull or divHBull, "Hội tụ RSI", "{{ticker}} {{interval}}: hội tụ giữa giá và RSI. Giá {{close}}")
alertcondition(divBear or divHBear, "Phân kỳ RSI", "{{ticker}} {{interval}}: phân kỳ giữa giá và RSI. Giá {{close}}")
alertcondition(rsiBreakUp or rsiBreakDown, "RSI phá trendline", "{{ticker}} {{interval}}: RSI phá trendline. RSI có thể đổi nhịp.")
alertcondition(volSpike, "Volume đột biến", "{{ticker}} {{interval}}: volume đột biến. Giá {{close}}")
